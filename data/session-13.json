  "lesson": {
    "summary": "الجلسة دي بتطبّق أدوات الملكية (mein/dein/sein/ihr) على العائلة: الـ e في الآخر مع المؤنث والجمع، ومن غيرها مع المذكر والمحايد، وبتفرّق بين sein (هو) وihr (هي)."
  },
  "grammar": [
    {
      "title": "e في الآخر = مؤنث أو جمع",
      "rule": "meine/deine/seine/ihre بتيجي مع المؤنث (die) والجمع. من غير e (mein/dein/sein/ihr) مع المذكر والمحايد (der, das).",
      "forms": [
        "mein / meine",
        "dein / deine",
        "sein / seine",
        "ihr / ihre"
      ],
      "examples": [
        {
          "de": "Das ist mein Buch.",
          "ar": "هذا كتابي."
        },
        {
          "de": "Das ist meine Wohnung.",
          "ar": "هذه شقتي."
        }
      ]
    },
    {
      "title": "sein = بتاعه، ihr = بتاعها",
      "rule": "Er (هو) بيستخدم sein/seine، و Sie (هي) بيستخدم ihr/ihre. النهاية بتتحدد بكلمة الشيء مش بالشخص.",
      "forms": [
        "Er → sein / seine",
        "Sie → ihr / ihre"
      ],
      "examples": [
        {
          "de": "Das ist sein Auto.",
          "ar": "هذه سيارته."
        },
        {
          "de": "Das ist ihre Tasche.",
          "ar": "هذه حقيبتها."
        }
      ]
    },
    {
      "title": "العائلة والملكية",
      "rule": "Familie مؤنث فبتاخد seine/ihre. Vater/Bruder مذكر فياخدوا sein/ihr. Mutter/Schwester مؤنث فياخدوا seine/ihre.",
      "forms": [
        "sein Vater / seine Mutter",
        "ihr Bruder / ihre Schwester"
      ],
      "examples": [
        {
          "de": "Das ist sein Vater und das ist seine Mutter.",
          "ar": "هذا والده وهذه والدته."
        },
        {
          "de": "Das ist ihr Bruder und das ist ihre Schwester.",
          "ar": "هذا أخوها وهذه أختها."
        }
      ]
    },
    {
      "title": "Das ist / Das sind",
      "rule": "مع المفرد: Das ist. مع الجمع (Eltern): Das sind.",
      "forms": [
        "Das ist seine Familie.",
        "Das sind ihre Eltern."
      ],
      "examples": [
        {
          "de": "Das sind ihre Eltern.",
          "ar": "هؤلاء والداها."
        }
      ]
    }
  ],
