 "lesson": {
  "summary": "الجلسة دي بتوسّع الجملة لباقي الضمائر: أنت، هو، هي، احنا، انتوا، حضرتك. نفس تركيب الجملة اللي اتعلمناه، بس بتصريف الفعل الصح لكل ضمير. اتفرج على فيديو الدرس الرابع، راجع جداول التصريح تحته، وبعدين كمّل التدريب.",
  "challenge": {
   "title": "Writing challenge (Barbarys Schreib-Challenge) ✍️",
   "intro": "Translate these sentences into German:",
   "items": [
    "أنت تقدر تطبخ الأكل وده سهل جدًا بالنسبة لك.",
    "احنا نقدر نتعلم ألماني مع بعض.",
    "هي بتقرا الكتاب دلوقتي."
   ],
   "note": "Build two long sentences with 'Du kannst ... und / aber das ist ... für dich'."
  }
 },
 "grammar": [
  {
   "title": "du, er/sie, wir, ihr, Sie: the verb endings",
   "rule": "كل ضمير ليه نهاية فعل ثابتة: du بتاخد -st، وer/sie بتاخد -t، وwir وSie بيفضلوا زي المصدر -en، وihr بياخد -t.",
   "forms": [
    "lernen: du lernst, er/sie lernt",
    "arbeiten: du arbeitest, er/sie arbeitet",
    "wir lernen, ihr lernt, Sie lernen",
    "wir arbeiten, ihr arbeitet, Sie arbeiten"
   ],
   "examples": [
    {
     "de": "Du lernst Deutsch.",
     "ar": "أنت بتتعلم ألماني."
    },
    {
     "de": "Wir arbeiten zusammen.",
     "ar": "احنا بنشتغل مع بعض."
    }
   ]
  },
  {
   "title": "können with every pronoun",
   "rule": "können مش منتظم: ich kann, du kannst, er/sie kann, wir können, ihr könnt, Sie können.",
   "forms": [
    "ich kann",
    "du kannst",
    "er/sie kann",
    "wir können",
    "ihr könnt",
    "Sie können"
   ],
   "examples": [
    {
     "de": "Ihr könnt jetzt schlafen.",
     "ar": "انتوا تقدروا تناموا دلوقتي."
    },
    {
     "de": "Sie können die Hausaufgabe machen.",
     "ar": "حضرتك تقدر تعمل الواجب."
    }
   ]
  },
  {
   "title": "Vowel change with du and er/sie",
   "rule": "أفعال زي schlafen وlesen وsprechen بتغيّر الحرف المتحرك مع du وer/sie: schlafen ← schläfst/schläft، lesen ← liest، sprechen ← sprichst/spricht.",
   "forms": [
    "schlafen → du schläfst, er schläft",
    "lesen → du liest, er liest",
    "sprechen → du sprichst, er spricht"
   ],
   "examples": [
    {
     "de": "Du schläfst jetzt.",
     "ar": "أنت بتنام دلوقتي."
    },
    {
     "de": "Er liest das Buch.",
     "ar": "هو بيقرا الكتاب."
    }
   ]
  },
  {
