  "lesson": {
    "summary": "الجلسة دي بتغطي المواقف الرسمية (استمارة، هوية، توقيع، سحب كارت) بأمر الاحترام مع Sie، وبتدرب على أسئلة وإجابات وطلبات امتحان المحادثة."
  },
  "grammar": [
    {
      "title": "أمر الاحترام مع Sie",
      "rule": "الفعل في الأول (بنهاية en) + Sie + bitte. الفعل المنفصل ausfüllen: Füllen في الأول وaus في الآخر.",
      "forms": [
        "Füllen Sie bitte das Formular aus!",
        "Unterschreiben Sie bitte hier!",
        "Ziehen Sie bitte eine Karte!"
      ],
      "examples": [
        {
          "de": "Füllen Sie bitte das Formular aus!",
          "ar": "املا الاستمارة!"
        }
      ]
    },
    {
      "title": "أسئلة اللجنة الرسمية",
      "rule": "أسئلة بتسمعها في أي إجراء رسمي.",
      "forms": [
        "Haben Sie einen Ausweis?",
        "Können Sie bitte Ihren Namen buchstabieren?",
        "Wie ist Ihre Postleitzahl?"
      ],
      "examples": [
        {
          "de": "Haben Sie einen Ausweis?",
          "ar": "معاك هوية؟"
        }
      ]
    },
    {
      "title": "امتحان المحادثة: ثلاث مهام",
      "rule": "1) Frage stellen: بتاخد كارت كلمة وبتسأل سؤال. 2) Antworten: بتجاوب على سؤال. 3) Bitte: بتطلب حاجة بأدب (Können Sie ... bitte ...?). كل الأسئلة والإجابات النموذجية متسجلة في الجمل، والبدائل (modelAlt) في صفحة التدريب.",
      "forms": [
        "Kaffee → Trinken Sie gern Kaffee? / Wie viel Kaffee trinken Sie am Tag?",
        "Wasser → Möchten Sie ein Glas Wasser? / Trinken Sie viel Wasser?",
        "Familie → Wie groß ist Ihre Familie? / Haben Sie Geschwister?",
        "Sport → Machen Sie gern Sport? / Welchen Sport machen Sie?",
        "Musik → Hören Sie gern Musik? / Was für Musik hören Sie gern?",
        "Urlaub → Wohin fahren Sie im Urlaub? / Wann haben Sie Urlaub?",
        "Wohnung → Wie ist Ihre Wohnung? / Wo wohnen Sie?",
        "Arbeit → Was sind Sie von Beruf? / Wo arbeiten Sie?",
        "Reise → Reisen Sie gern? / Wohin möchten Sie reisen?"
      ],
      "examples": [
        {
          "de": "Können Sie mir bitte helfen?",
          "ar": "ممكن تساعدني؟"
        }
      ]
    },
    {
      "title": "ملاحظة على المصدر: صفحة التدريب",
      "rule": "تدريب الاستمارة (8 تمارين + الاختبار النهائي) بيشتغل بالصوت والإملاء في صفحة تدريب الامتحان نفسها (materials/a1/lesson-28-exam-training.html)، فمش اتحولت لمقاطع صوت هنا. الجمل النموذجية بس هي اللي في الصوت.",
      "forms": [
        "8 تمارين استمارة + استمارة نهائية",
        "20 كارت أسئلة",
        "15 سؤال إجابة",
        "13 كارت طلب",
        "8 مهام امتحان نهائي"
      ],
      "examples": []
    }
  ],
