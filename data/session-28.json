  "sentences": [
    {
      "de": "Füllen Sie bitte das Formular aus!",
      "ar": "من فضلك املا الاستمارة!",
      "audio": "audio/s28/s01-fuellen-sie-bitte-das-formular-aus.mp3"
    },
    {
      "de": "Haben Sie einen Ausweis?",
      "ar": "معاك بطاقة هوية؟",
      "audio": "audio/s28/s02-haben-sie-einen-ausweis.mp3"
    },
    {
      "de": "Können Sie bitte Ihren Namen buchstabieren?",
      "ar": "ممكن من فضلك تهجّي اسمك؟",
      "audio": "audio/s28/s03-koennen-sie-bitte-ihren-namen-buchstabieren.mp3"
    },
    {
      "de": "Unterschreiben Sie bitte hier!",
      "ar": "من فضلك وقّع هنا!",
      "audio": "audio/s28/s04-unterschreiben-sie-bitte-hier.mp3"
    },
    {
      "de": "Wie ist Ihre Postleitzahl?",
      "ar": "إيه الرمز البريدي بتاعك؟",
      "audio": "audio/s28/s05-wie-ist-ihre-postleitzahl.mp3"
    },
    {
      "de": "Ziehen Sie bitte eine Karte!",
      "ar": "من فضلك اسحب كارت!",
      "audio": "audio/s28/s06-ziehen-sie-bitte-eine-karte.mp3"
    },
    {
      "de": "Trinken Sie gern Kaffee?",
      "ar": "بتحب تشرب قهوة؟",
      "audio": "audio/s28/s07-trinken-sie-gern-kaffee.mp3"
    },
    {
      "de": "Möchten Sie ein Glas Wasser?",
      "ar": "تحب كوباية ميه؟",
      "audio": "audio/s28/s08-moechten-sie-ein-glas-wasser.mp3"
    },
    {
      "de": "Wie groß ist Ihre Familie?",
      "ar": "عيلتك كبيرة قد إيه؟",
      "audio": "audio/s28/s09-wie-gross-ist-ihre-familie.mp3"
    },
    {
      "de": "Was machen Sie am Wochenende?",
      "ar": "بتعمل إيه في الويك إند؟",
      "audio": "audio/s28/s10-was-machen-sie-am-wochenende.mp3"
    },
    {
      "de": "Machen Sie gern Sport?",
      "ar": "بتحب الرياضة؟",
      "audio": "audio/s28/s11-machen-sie-gern-sport.mp3"
    },
    {
      "de": "Hören Sie gern Musik?",
      "ar": "بتحب تسمع موسيقى؟",
      "audio": "audio/s28/s12-hoeren-sie-gern-musik.mp3"
    },
    {
      "de": "Wohin fahren Sie im Urlaub?",
      "ar": "بتسافر فين في الإجازة؟",
      "audio": "audio/s28/s13-wohin-fahren-sie-im-urlaub.mp3"
    },
    {
      "de": "Haben Sie ein Auto?",
      "ar": "عندك عربية؟",
      "audio": "audio/s28/s14-haben-sie-ein-auto.mp3"
    },
    {
      "de": "Fahren Sie oft mit dem Bus?",
      "ar": "بتركب الأتوبيس كتير؟",
      "audio": "audio/s28/s15-fahren-sie-oft-mit-dem-bus.mp3"
    },
    {
      "de": "Gehen Sie gern ins Restaurant?",
      "ar": "بتحب تروح المطعم؟",
      "audio": "audio/s28/s16-gehen-sie-gern-ins-restaurant.mp3"
    },
    {
      "de": "Wie oft gehen Sie ins Kino?",
      "ar": "بتروح السينما كام مرة؟",
      "audio": "audio/s28/s17-wie-oft-gehen-sie-ins-kino.mp3"
    },
    {
      "de": "Wann haben Sie Geburtstag?",
      "ar": "عيد ميلادك إمتى؟",
      "audio": "audio/s28/s18-wann-haben-sie-geburtstag.mp3"
    },
    {
      "de": "Wie ist Ihre Wohnung?",
      "ar": "شقتك عاملة إزاي؟",
      "audio": "audio/s28/s19-wie-ist-ihre-wohnung.mp3"
    },
    {
      "de": "Was sind Sie von Beruf?",
      "ar": "إيه مهنتك؟",
      "audio": "audio/s28/s20-was-sind-sie-von-beruf.mp3"
    },
    {
      "de": "Gehen Sie noch zur Schule?",
      "ar": "لسه بتروح المدرسة؟",
      "audio": "audio/s28/s21-gehen-sie-noch-zur-schule.mp3"
    },
    {
      "de": "Wo kaufen Sie gern ein?",
      "ar": "بتحب تتسوق منين؟",
      "audio": "audio/s28/s22-wo-kaufen-sie-gern-ein.mp3"
    },
    {
      "de": "Spielen Sie gern Fußball?",
      "ar": "بتحب تلعب كورة؟",
      "audio": "audio/s28/s23-spielen-sie-gern-fussball.mp3"
    },
    {
      "de": "Lesen Sie gern Bücher?",
      "ar": "بتحب تقرا كتب؟",
      "audio": "audio/s28/s24-lesen-sie-gern-buecher.mp3"
    },
    {
      "de": "Reisen Sie gern?",
      "ar": "بتحب السفر؟",
      "audio": "audio/s28/s25-reisen-sie-gern.mp3"
    },
    {
      "de": "Was machen Sie in den Ferien?",
      "ar": "بتعمل إيه في الإجازة؟",
      "audio": "audio/s28/s26-was-machen-sie-in-den-ferien.mp3"
    },
    {
      "de": "Kann ich bitte Wasser haben?",
      "ar": "ممكن ميه من فضلك؟",
      "audio": "audio/s28/s27-kann-ich-bitte-wasser-haben.mp3"
    },
    {
      "de": "Ich möchte bitte einen Kaffee.",
      "ar": "عايز قهوة من فضلك.",
      "audio": "audio/s28/s28-ich-moechte-bitte-einen-kaffee.mp3"
    },
    {
      "de": "Können Sie bitte das Fenster öffnen?",
      "ar": "ممكن تفتح الشباك؟",
      "audio": "audio/s28/s29-koennen-sie-bitte-das-fenster-oeffnen.mp3"
    },
    {
      "de": "Können Sie bitte die Tür schließen?",
      "ar": "ممكن تقفل الباب؟",
      "audio": "audio/s28/s30-koennen-sie-bitte-die-tuer-schliessen.mp3"
    },
    {
      "de": "Haben Sie bitte einen Stift für mich?",
      "ar": "معاك قلم من فضلك؟",
      "audio": "audio/s28/s31-haben-sie-bitte-einen-stift-fuer-mich.mp3"
    },
    {
      "de": "Kann ich bitte das Buch haben?",
      "ar": "ممكن الكتاب من فضلك؟",
      "audio": "audio/s28/s32-kann-ich-bitte-das-buch-haben.mp3"
    },
    {
      "de": "Kann ich bitte Ihr Handy benutzen?",
      "ar": "ممكن أستخدم موبايلك؟",
      "audio": "audio/s28/s33-kann-ich-bitte-ihr-handy-benutzen.mp3"
    },
    {
      "de": "Können Sie mir bitte helfen?",
      "ar": "ممكن تساعدني من فضلك؟",
      "audio": "audio/s28/s34-koennen-sie-mir-bitte-helfen.mp3"
    },
    {
      "de": "Können Sie mir bitte die Tasche geben?",
      "ar": "ممكن تدّيني الشنطة؟",
      "audio": "audio/s28/s35-koennen-sie-mir-bitte-die-tasche-geben.mp3"
    },
    {
      "de": "Können Sie mir bitte Geld wechseln?",
      "ar": "ممكن تصرفلي فلوس؟",
      "audio": "audio/s28/s36-koennen-sie-mir-bitte-geld-wechseln.mp3"
    },
    {
      "de": "Können Sie mir bitte sagen, wie spät es ist?",
      "ar": "ممكن تقولي الساعة كام؟",
      "audio": "audio/s28/s37-koennen-sie-mir-bitte-sagen-wie-spaet-es-ist.mp3"
    },
    {
      "de": "Können Sie mir bitte Ihre Adresse geben?",
      "ar": "ممكن تدّيني عنوانك؟",
      "audio": "audio/s28/s38-koennen-sie-mir-bitte-ihre-adresse-geben.mp3"
    },
    {
      "de": "Können Sie mir bitte Ihre Telefonnummer geben?",
      "ar": "ممكن تدّيني رقم تليفونك؟",
      "audio": "audio/s28/s39-koennen-sie-mir-bitte-ihre-telefonnummer-geb.mp3"
    },
    {
      "de": "Wie heißen Sie?",
      "ar": "اسمك إيه؟",
      "audio": "audio/s28/s40-wie-heissen-sie.mp3"
    },
    {
      "de": "Ich heiße Nour.",
      "ar": "اسمي نور.",
      "audio": "audio/s28/s41-ich-heisse-nour.mp3"
    },
    {
      "de": "Mein Name ist Omar.",
      "ar": "اسمي عمر.",
      "audio": "audio/s28/s42-mein-name-ist-omar.mp3"
    },
    {
      "de": "Woher kommen Sie?",
      "ar": "جاي منين؟",
      "audio": "audio/s28/s43-woher-kommen-sie.mp3"
    },
    {
      "de": "Ich komme aus Ägypten.",
      "ar": "أنا من مصر.",
      "audio": "audio/s28/s44-ich-komme-aus-aegypten.mp3"
    },
    {
      "de": "Ich komme aus Syrien.",
      "ar": "أنا من سوريا.",
      "audio": "audio/s28/s45-ich-komme-aus-syrien.mp3"
    },
    {
      "de": "Am Wochenende spiele ich Fußball.",
      "ar": "في الويك إند بلعب كورة.",
      "audio": "audio/s28/s46-am-wochenende-spiele-ich-fussball.mp3"
    },
    {
      "de": "Ich treffe meine Freunde.",
      "ar": "بقابل أصحابي.",
      "audio": "audio/s28/s47-ich-treffe-meine-freunde.mp3"
    },
    {
      "de": "Was essen Sie gern?",
      "ar": "بتحب تاكل إيه؟",
      "audio": "audio/s28/s48-was-essen-sie-gern.mp3"
    },
    {
      "de": "Ich esse gern Pizza.",
      "ar": "بحب آكل بيتزا.",
      "audio": "audio/s28/s49-ich-esse-gern-pizza.mp3"
    },
    {
      "de": "Ich esse gern Reis mit Hähnchen.",
      "ar": "بحب آكل رز بفراخ.",
      "audio": "audio/s28/s50-ich-esse-gern-reis-mit-haehnchen.mp3"
    },
    {
      "de": "Was trinken Sie zum Frühstück?",
      "ar": "بتشرب إيه في الفطار؟",
      "audio": "audio/s28/s51-was-trinken-sie-zum-fruehstueck.mp3"
    },
    {
      "de": "Ich trinke Tee zum Frühstück.",
      "ar": "بشرب شاي في الفطار.",
      "audio": "audio/s28/s52-ich-trinke-tee-zum-fruehstueck.mp3"
    },
    {
      "de": "Ich trinke Kaffee mit Milch.",
      "ar": "بشرب قهوة بلبن.",
      "audio": "audio/s28/s53-ich-trinke-kaffee-mit-milch.mp3"
    },
    {
      "de": "Wo arbeiten Sie?",
      "ar": "بتشتغل فين؟",
      "audio": "audio/s28/s54-wo-arbeiten-sie.mp3"
    },
    {
      "de": "Ich arbeite in einem Büro.",
      "ar": "بشتغل في مكتب.",
      "audio": "audio/s28/s55-ich-arbeite-in-einem-buero.mp3"
    },
    {
      "de": "Ich arbeite in einem Restaurant.",
      "ar": "بشتغل في مطعم.",
      "audio": "audio/s28/s56-ich-arbeite-in-einem-restaurant.mp3"
    },
    {
      "de": "Wie kommen Sie zur Arbeit?",
      "ar": "بتروح الشغل إزاي؟",
      "audio": "audio/s28/s57-wie-kommen-sie-zur-arbeit.mp3"
    },
    {
      "de": "Ich fahre mit dem Bus.",
      "ar": "بروح بالأتوبيس.",
      "audio": "audio/s28/s58-ich-fahre-mit-dem-bus.mp3"
    },
    {
      "de": "Ich fahre mit dem Auto.",
      "ar": "بروح بالعربية.",
      "audio": "audio/s28/s59-ich-fahre-mit-dem-auto.mp3"
    },
    {
