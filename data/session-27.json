  "lesson": {
    "summary": "الجلسة دي بتعلمك تكتب إيميل رسمي لحجز فندق: افتتاحية وخاتمة ثابتة، weil (الفعل في الآخر)، ankommen المنفصل، وأسئلة السعر والمدة."
  },
  "grammar": [
    {
      "title": "هيكل الإيميل الرسمي",
      "rule": "افتتاحية: Sehr geehrte Damen und Herren, (لما متعرفش الاسم). وبعدين السبب، الطلب، الوصول، المدة، السؤال عن السعر. وخاتمة: Mit freundlichen Grüßen.",
      "forms": [
        "Sehr geehrte Damen und Herren,",
        "Wir schreiben Ihnen, weil ...",
        "Wir möchten ... buchen.",
        "Wir kommen am Freitag an.",
        "Wir möchten zwei Nächte bleiben.",
        "Wie viel kostet das Zimmer?",
        "Mit freundlichen Grüßen"
      ],
      "examples": [
        {
          "de": "Wir möchten ein Doppelzimmer im Hotel buchen.",
          "ar": "عايزين نحجز أوضة مزدوجة."
        }
      ]
    },
    {
      "title": "weil: الفعل في الآخر",
      "rule": "weil بترمي الفعل المتصرف في آخر الجملة: ..., weil wir Informationen möchten.",
      "forms": [
        "..., weil wir Informationen möchten"
      ],
      "examples": [
        {
          "de": "Wir schreiben Ihnen, weil wir Informationen möchten.",
          "ar": "بنكتبلكم لأننا عايزين معلومات."
        }
      ]
    },
    {
      "title": "ankommen فعل منفصل",
      "rule": "ankommen بيتقسم: Wir kommen am Freitag an.",
      "forms": [
        "Wir kommen ... an",
        "Ich komme am Montag an"
      ],
      "examples": [
        {
          "de": "Wir kommen am Freitag an.",
          "ar": "هنوصل الجمعة."
        }
      ]
    }
  ],
