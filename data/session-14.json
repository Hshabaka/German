  "lesson": {
    "summary": "الجلسة دي بتعلّمك المقارنة (Komparativ: صفة+er+als) والصيغة العليا (Superlativ: am+صفة+sten) مع Umlaut وحذف الـ e والشاذة gut/viel/gern/hoch/nah، وتطبقها على الملابس والألوان."
  },
  "grammar": [
    {
      "title": "Komparativ: صفة + er + als",
      "rule": "للمقارنة بين حاجتين: الصفة + er + als. أمثلة: klein → kleiner als، schön → schöner als. أوعى تقول wie بعد المقارنة.",
      "forms": [
        "klein → kleiner als",
        "schön → schöner als"
      ],
      "examples": [
        {
          "de": "Der Hund ist größer als die Katze.",
          "ar": "الكلب أكبر من القطة."
        },
        {
          "de": "Die Jacke ist schöner als das Hemd.",
          "ar": "الجاكيت أجمل من القميص."
        }
      ]
    },
    {
      "title": "Umlaut وحذف الـ e",
      "rule": "الصفات القصيرة اللي فيها a/o/u غالبًا بتاخد نقطتين: alt → älter، groß → größer، jung → jünger. والصفات اللي آخرها er زي teuer بتشيل الـ e: teurer (مش teuerer). بعد als الفاعل Nominativ: als ich.",
      "forms": [
        "alt → älter",
        "groß → größer",
        "jung → jünger",
        "teuer → teurer"
      ],
      "examples": [
        {
          "de": "Das Handy ist teurer als das Buch.",
          "ar": "الموبايل أغلى من الكتاب."
        }
      ]
    },
    {
      "title": "الشاذة: gut / viel / gern",
      "rule": "بتتحفظ زي ما هي: gut → besser، viel → mehr، gern → lieber.",
      "forms": [
        "gut → besser",
        "viel → mehr",
        "gern → lieber"
      ],
      "examples": [
        {
          "de": "Ich habe mehr Hunger als du.",
          "ar": "أنا جعان أكتر منك."
        },
        {
          "de": "Ich esse lieber Eier als Brot.",
          "ar": "أنا بحب آكل بيض أكتر من العيش."
        }
      ]
    },
    {
      "title": "Superlativ: am + صفة + sten",
      "rule": "الصيغة العليا: am + الصفة + sten. وبعد حروف t, d, s, ß, z, x, sch بنزود esten: spät → am spätesten، süß → am süßesten. وفي القصير مع a/o/u بيجيلها Umlaut: jung → am jüngsten، groß → am größten.",
      "forms": [
        "schnell → am schnellsten",
        "alt → am ältesten",
        "süß → am süßesten"
      ],
      "examples": [
        {
          "de": "Ahmed läuft am schnellsten.",
          "ar": "أحمد بيجري الأسرع."
        }
      ]
    },
    {
      "title": "Superlativ الشاذ",
      "rule": "gut → am besten، viel → am meisten، gern → am liebsten، hoch → am höchsten، nah → am nächsten. أخطاء شائعة: am lieber، am gutsten، am schnellste، am warmsten، am hochsten.",
      "forms": [
        "am besten",
        "am meisten",
        "am liebsten",
        "am höchsten",
        "am nächsten"
      ],
      "examples": [
        {
          "de": "Ich trinke Tee am liebsten.",
          "ar": "أنا بحب الشاي أكتر حاجة."
        },
        {
          "de": "Das Haus ist am höchsten.",
          "ar": "البيت الأعلى."
        }
      ]
    }
  ],
