  "lesson": {
    "summary": "الجلسة دي بتعلمك تقيّم الأكل وتعبر عن الجوع والعطش: schmecken (يعجب)، Ich habe Hunger/Durst. والمكعب الجديد الكبير: Sie بمعنى حضرتك، والحلو إن الفعل معاها بيرجع للمصدر من غير أي تصريف، زي wir بالظبط. كمان فيها الاختبار الشامل للدروس 1-7."
  },
  "grammar": [
    {
      "title": "schmecken: التعبير عن الطعم",
      "rule": "بنستخدم schmecken عشان نقول رأينا في الأكل: Das Essen schmeckt gut (طعمه كويس). ومع mir بقى معناها عجبني: Das schmeckt mir (الأكل عجبني).",
      "forms": [
        "das schmeckt gut",
        "das schmeckt nicht",
        "das schmeckt mir"
      ],
      "examples": [
        {
          "de": "Das Fleisch schmeckt sehr lecker.",
          "ar": "اللحم طعمه لذيذ جداً."
        },
        {
          "de": "Der Fisch schmeckt mir nicht.",
          "ar": "السمك معجبنيش."
        }
      ]
    },
    {
      "title": "Hunger und Durst: الجوع والعطش",
      "rule": "الجوع والعطش بنعبر عنهم بـ haben: Ich habe Hunger (أنا جعان)، Ich habe Durst (أنا عطشان).",
      "forms": [
        "ich habe Hunger",
        "ich habe Durst",
        "du hast Hunger"
      ],
      "examples": [
        {
          "de": "Ich habe Hunger und das Essen schmeckt lecker.",
          "ar": "أنا جعان والأكل طعمه لذيذ."
        },
        {
          "de": "Hast du Hunger?",
          "ar": "انت جعان؟"
        }
      ]
    },
    {
      "title": "Sie: صيغة الاحترام",
      "rule": "Sie (حضرتك) بنستخدمها مع الكبار والرسمي، والفعل معاها بيرجع للمصدر من غير تصريف، زي wir: Du isst بس Sie essen، Du hast بس Sie haben، Du musst بس Sie müssen.",
      "forms": [
        "Sie essen",
        "Sie haben",
        "Sie müssen / können"
      ],
      "examples": [
        {
          "de": "Sie essen jeden Morgen Brot.",
          "ar": "حضرتك تأكل الخبز كل صباح."
        },
        {
          "de": "Sie müssen etwas trinken.",
          "ar": "لازم حضرتك تشرب حاجة."
        }
      ]
    },
    {
      "title": "السؤال: الفعل الأول",
      "rule": "عشان نعمل سؤال بنقدم الفعل على الفاعل: Du hast Hunger تبقى Hast du Hunger? ومع حضرتك: Haben Sie Hunger?",
      "forms": [
        "Hast du Hunger?",
        "Hast du Durst?",
        "Haben Sie Hunger?"
      ],
      "examples": [
        {
          "de": "Haben Sie Hunger?",
          "ar": "حضرتك جعان؟"
        },
        {
          "de": "Haben Sie Durst?",
          "ar": "حضرتك عطشان؟"
        }
      ]
    }
  ],
