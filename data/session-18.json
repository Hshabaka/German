  "lesson": {
    "summary": "الجلسة دي بتكمل الحالات مع المؤنث: die ثابتة في Nom وAkk وبتتحول لـ der في Dativ، مع تطبيق مكثف على 16 كلمة مذكر ومؤنث (معرفة ونكرة ونفي وضمائر) وweil."
  },
  "grammar": [
    {
      "title": "القاعدة العامة: Nom / Akk / Dat",
      "rule": "1) بتوصف الشيء: Nominativ. 2) بتعمل بيه حاجة: Akkusativ. 3) بتعمل لمصلحته: Dativ. الأدوات والضمائر المؤنثة بتفضل زي ما هي في Akkusativ، وبتتغير بس في Dativ.",
      "forms": [
        "وصف = Nom",
        "فعل واقع = Akk",
        "مصلحة = Dat"
      ],
      "examples": [
        {
          "de": "Der Apfel ist lecker.",
          "ar": "التفاحة لذيذة."
        },
        {
          "de": "Ich esse den Apfel.",
          "ar": "أنا آكل التفاحة."
        }
      ]
    },
    {
      "title": "المؤنث: die ثابت ثم der",
      "rule": "المؤنث: Nom die، Akk die (من غير تغيير)، Dat der. ومع Ihr: Ihr seht die Frau / Ihr helft der Frau.",
      "forms": [
        "die Frau → die Frau → der Frau",
        "die Lehrerin → die Lehrerin → der Lehrerin"
      ],
      "examples": [
        {
          "de": "Ihr fragt die Lehrerin.",
          "ar": "إنتم بتسألوا المعلمة."
        },
        {
          "de": "Ihr antwortet der Lehrerin.",
          "ar": "إنتم بتجاوبوا المعلمة."
        }
      ]
    },
    {
      "title": "جدول المذكر: معرفة/نكرة/نفي/ضمائر (PDF 18-2)",
      "rule": "لكل كلمة مذكرة: Nom / Akk / Dat. المعرفة: der / den / dem. النكرة: ein / einen / einem. النفي: kein / keinen / keinem. الضمائر: er / ihn / ihm.",
      "forms": [
        "Apfel: ein Apfel / einen Apfel / einem Apfel | kein Apfel / keinen Apfel / keinem Apfel | er / ihn / ihm",
        "Tisch: ein Tisch / einen Tisch / einem Tisch | kein Tisch / keinen Tisch / keinem Tisch | er / ihn / ihm",
        "Hund: ein Hund / einen Hund / einem Hund | kein Hund / keinen Hund / keinem Hund | er / ihn / ihm",
        "Computer: ein Computer / einen Computer / einem Computer | kein Computer / keinen Computer / keinem Computer | er / ihn / ihm",
        "Stuhl: ein Stuhl / einen Stuhl / einem Stuhl | kein Stuhl / keinen Stuhl / keinem Stuhl | er / ihn / ihm",
        "Saft: ein Saft / einen Saft / einem Saft | kein Saft / keinen Saft / keinem Saft | er / ihn / ihm",
        "Kuchen: ein Kuchen / einen Kuchen / einem Kuchen | kein Kuchen / keinen Kuchen / keinem Kuchen | er / ihn / ihm",
        "Ball: ein Ball / einen Ball / einem Ball | kein Ball / keinen Ball / keinem Ball | er / ihn / ihm"
      ],
      "examples": [
        {
          "de": "Ich esse keinen Apfel.",
          "ar": "أنا ما باكلش تفاحة."
        },
        {
          "de": "Ich gebe ihm 5 Sterne.",
          "ar": "أنا أعطيه 5 نجوم."
        }
      ]
    },
    {
