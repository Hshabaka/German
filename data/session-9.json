  "lesson": {
    "summary": "الجلسة دي بتكمل عائلة الأفعال المساعدة كلها: möchten (طلب مؤدب)، wollen (تصميم)، dürfen (سماح)، sollen (تكليف). والقاعدة الذهبية: تصريف ich هو نفسه تصريف er/sie/es في كل الأفعال المساعدة. ومعهم مكعبات الصحة: rauchen، nehmen، das Medikament، im Bett bleiben."
  },
  "grammar": [
    {
      "title": "القاعدة الذهبية: ich = er/sie/es",
      "rule": "في كل الأفعال المساعدة، تصريف أنا (ich) هو بالظبط تصريف هو/هي (er/sie/es): ich will يبقى er will، ich darf يبقى sie darf. احفظ تصريف أنا وانت كده حفظت هو/هي.",
      "forms": [
        "ich will / er will",
        "ich darf / sie darf",
        "ich soll / es soll"
      ],
      "examples": [
        {
          "de": "Er soll das Medikament nehmen.",
          "ar": "ينبغي عليه ياخد الدواء."
        },
        {
          "de": "Sie will das Essen kochen.",
          "ar": "هي عايزة تطبخ الأكل."
        }
      ]
    },
    {
      "title": "möchten: الطلب المؤدب",
      "rule": "möchten معناها يود/يرغب، وهي الأسلوب المؤدب للطلبات: Ich möchte Kaffee trinken. أشيك من will.",
      "forms": [
        "ich möchte",
        "du möchtest",
        "wir möchten"
      ],
      "examples": [
        {
          "de": "Ich möchte Deutsch lernen.",
          "ar": "أود أتعلم ألماني."
        },
        {
          "de": "Wir möchten viel Wasser trinken.",
          "ar": "بنود نشرب مية كتير."
        }
      ]
    },
    {
      "title": "dürfen: السماح",
      "rule": "dürfen معناها مسموح: Ich darf das essen (مسموح لي آكل ده)، والنفي: Ich darf nicht schlafen (مش مسموح لي أنام).",
      "forms": [
        "ich darf",
        "du darfst",
        "sie dürfen"
      ],
      "examples": [
        {
          "de": "Du darfst hier nicht rauchen!",
          "ar": "مش مسموح لك التدخين هنا!"
        },
        {
          "de": "Sie dürfen nicht rauchen.",
          "ar": "مش مسموح لهم بالتدخين."
        }
      ]
    },
    {
      "title": "sollen: التكليف",
      "rule": "sollen معناها ينبغي، تكليف أو نصيحة من حد تاني (زي الدكتور): Sie sollen das Medikament nehmen (الدكتور اللي قالهم).",
      "forms": [
        "ich soll",
        "du sollst",
        "sie sollen"
      ],
      "examples": [
        {
          "de": "Ich soll schlafen gehen.",
          "ar": "ينبغي علي أروح أنام."
        },
        {
          "de": "Sie sollen im Bett bleiben.",
          "ar": "ينبغي عليهم يفضلوا في السرير."
        }
      ]
    }
  ],
