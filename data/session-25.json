  "lesson": {
    "summary": "الجلسة دي بتعلمك الماضي التام (Perfekt): haben/sein في المركز التاني + Partizip II في الآخر، والفرق بين haben وsein، والأفعال المنتظمة والمنفصلة والشاذة."
  },
  "grammar": [
    {
      "title": "تركيبة الـ Perfekt",
      "rule": "المساعد haben أو sein في المركز التاني + Partizip II (التصريف الثالث) في آخر الجملة.",
      "forms": [
        "haben / sein (المركز 2) + Partizip II (الآخر)"
      ],
      "examples": [
        {
          "de": "Ich habe eine Pizza gegessen.",
          "ar": "أكلت بيتزا."
        },
        {
          "de": "Er ist nach Kairo gefahren.",
          "ar": "سافر القاهرة."
        }
      ]
    },
    {
      "title": "haben ولا sein؟",
      "rule": "haben: أفعال السكون والحركة في نفس المكان. sein: الانتقال من مكان لمكان، وتغيير الحالة (ينام/يصحى). الاستثناء: bleiben ياخد sein رغم إنه ثابت.",
      "forms": [
        "haben: essen, spielen, schlafen",
        "sein: gehen, fahren, kommen, fliegen, reisen, ankommen",
        "sein: aufstehen, einschlafen (تغيير حالة)",
        "استثناء: bleiben → ist geblieben"
      ],
      "examples": [
        {
          "de": "Ali ist zu Hause geblieben.",
          "ar": "علي فضل في البيت."
        }
      ]
    },
    {
      "title": "الأفعال المنتظمة ge...t",
      "rule": "ge في الأول وt في الآخر. لو الجذر بيخلص بـ t/d بنزود e: arbeiten → gearbeitet.",
      "forms": [
        "machen → gemacht",
        "lernen → gelernt",
        "kochen → gekocht",
        "spielen → gespielt",
        "hören → gehört",
        "kaufen → gekauft",
        "arbeiten → gearbeitet",
        "fragen → gefragt",
        "sagen → gesagt",
        "reisen → gereist (sein)"
      ],
      "examples": [
        {
          "de": "Ich habe Deutsch gelernt.",
          "ar": "اتعلمت ألماني."
        }
      ]
    },
    {
      "title": "الأفعال المنفصلة: ge في النص",
      "rule": "الـ ge بتدخل في النص بين البادئة والفعل.",
      "forms": [
        "einkaufen → eingekauft",
        "aufräumen → aufgeräumt",
        "aufmachen → aufgemacht",
        "zumachen → zugemacht",
        "abholen → abgeholt",
        "aufstehen → aufgestanden (sein)",
        "einschlafen → eingeschlafen (sein)",
        "ankommen → angekommen (sein)"
      ],
      "examples": [
        {
          "de": "Wir haben im Supermarkt eingekauft.",
          "ar": "اتسوقنا."
        }
      ]
    },
    {
      "title": "الأفعال الشاذة (-en)",
      "rule": "بتحتفظ بنهاية en وبيتغير شكلها.",
      "forms": [
        "sprechen → gesprochen",
        "essen → gegessen",
        "trinken → getrunken",
        "lesen → gelesen",
