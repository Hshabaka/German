t-du.mp3"},{"de":"Ich heiße …","ar":"اسمي …","noaudio":true,"audio_target":"audio/vocab/58-ich-heisse.mp3"},{"de":"Ich bin …","ar":"أنا …","noaudio":true,"audio_target":"audio/vocab/59-ich-bin.mp3"},{"de":"Mein Name ist …","ar":"اسمي …","noaudio":true,"audio_target":"audio/vocab/60-mein-name-ist.mp3"},{"de":"Wer bist du?","ar":"إنت مين؟","noaudio":true,"audio_target":"audio/vocab/61-wer-bist-du.mp3"},{"de":"Wie heißen Sie?","ar":"حضرتك اسمك إيه؟ (رسمي)","noaudio":true,"audio_target":"audio/vocab/62-wie-heissen-sie.mp3"}]}],"sentences":[{"de":"Ich lerne Deutsch.","ar":"أنا أتعلم الألماني.","audio":"audio/ich-lerne-deutsch.mp3"},{"de":"Ich trinke Kaffee.","ar":"أنا أشرب قهوة.","audio":"audio/ich-trinke-kaffee.mp3"},{"de":"Ich kann Deutsch sprechen.","ar":"أقدر أتكلم ألماني.","audio":"audio/ich-kann-deutsch-sprechen.mp3"},{"de":"Ich kann Gitarre spielen.","ar":"أقدر أعزف جيتار.","audio":"audio/ich-kann-gitarre-spielen.mp3"},{"de":"Ich kann Schach spielen.","ar":"أقدر ألعب شطرنج.","noaudio":true,"audio_target":"audio/ich-kann-schach-spielen.mp3"},{"de":"Ich gehe ins Kino.","ar":"أنا رايح السينما.","noaudio":true,"audio_target":"audio/ich-gehe-ins-kino.mp3"},{"de":"Ich kann Musik hören.","ar":"أقدر أسمع موسيقى.","noaudio":true,"audio_target":"audio/ich-kann-musik-hoeren.mp3"},{"de":"Ich kann tanzen und singen.","ar":"أقدر أرقص وأغني.","noaudio":true,"audio_target":"audio/ich-kann-tanzen-und-singen.mp3"},{"de":"Wie heißt du?","ar":"اسمك إيه؟","noaudio":true,"audio_target":"audio/wie-heisst-du.mp3"},{"de":"Ich heiße Ali.","ar":"اسمي علي.","noaudio":true,"audio_target":"audio/ich-heisse-ali.mp3"}],"cards":[{"de":"ich lerne","ar":"أنا أتعلم"},{"de":"ich trinke","ar":"أنا أشرب"},{"de":"ich höre","ar":"أنا أسمع"},{"de":"ich koche","ar":"أنا أطبخ"},{"de":"Kaffee","article":"der","ar":"القهوة"},{"de":"Wasser","article":"das","ar":"الماء"},{"de":"Zeitung","article":"die","ar":"الجريدة"},{"de":"Kino","article":"das","ar":"السينما"}],"quiz":[{"prompt":"Ich ______ Musik.","options":["höre","lese","trinke"],"answer":0,"why":"الموسيقى بتتسمع، فالصح höre (أسمع)."},{"prompt":"Ich kann Gitarre ______.","options":["spielen","spiele"],"answer":0,"why":"بعد kann الفعل بيبقى مصدر في آخر الجملة: spielen."},{"prompt":"Ich ______ Französisch.","options":["spreche","trinke"],"answer":0,"why":"اللغة بنتكلمها: spreche (أتكلم)."},{"prompt":"Ich kann ins Kino ______.","options":["gehen","gehe"],"answer":0,"why":"بعد kann الفعل مصدر: gehen."},{"prompt":"Ich kann das Radio ______.","options":["hören","höre"],"answer":0,"why":"بعد kann الفعل مصدر: hören."},{"prompt":"Ich ______ ins Kino.","options":["gehe","gehen"],"answer":0,"why":"مع ich وبدون kann الفعل بيبقى gehe."},{"prompt":"Ich kann ins Café ______.","options":["gehen","gehe"],"answer":0,"why":"بعد kann الفعل مصدر في الآخر: gehen."},{"prompt":"Ich kann ______ spielen.","options":["Tennis","joggen","singen"],"answer":0,"why":"spielen بتيجي مع لعبة أو آلة: Tennis."},{"prompt":"Ich ______ die Zeitung.","options":["lese","höre"],"answer":0,"why":"الجريدة بتتقرا: lese (أقرأ)."},{"prompt":"Ich ______ Pizza.","options":["mache","machen"],"answer":0,"why":"مع ich الفعل بيبقى mache."}],"tracker":[{"id":"read-vocab","title":"قريت الكلمات في التابات"},{"id":"heard-sentences","title":"سمعت الجمل وكررتها بصوت عالي"},{"id":"did-cards","title":"خلصت بطاقات الكلمات"},{"id":"did-quiz","title":"خلصت الاختبار السريع"},{"id":"review-1d","title":"راجعت بعد يوم"},{"id":"review-7d","title":"راجعت بعد ٧ أيام"},{"id":"did-practice","title":"خلصت تدريب الجمل (ترتيب وتصحيح)"}],"extra":{"label":"تدريب إضافي اختياري من موقع DW الرسمي (الحلقة ٥)","links":[{"title":"فيديو الحلقة والتمارين على DW","url":"https://learngerman.dw.com/en/ich-hei%C3%9Fe-emma/l-37262882"},{"title":"تمرين تفاعلي: السؤال عن الاسم","url":"https://learngerman.dw.com/en/asking-what-someone-is-called/l-37262882/e-43702442"},{"title":"نص الحلقة","url":"https://learngerman.dw.com/en/ich-hei%C3%9Fe-emma/l-37262882/lm"}],"source_title":"Nicos Weg · Ich heiße Emma"},"lesson":{"summary":"الجلسة دي أول خطوة: بتتعلم تكوّن جملة ألمانية كاملة عن نفسك من غير ما تحفظ قواعد معقدة. اتفرج على فيديو الدرس الأول، وبعدين اقرا القاعدة تحته، وبعدها كمّل التدريب اللي في الصفحة.","challenge":{"title":"تحدي الكتابة (Barbarys Schreib-Challenge) ✍️","intro":"ترجم الجمل دي من فضلك:","items":["أنا أقدر أتعلم وأقرا وأكتب اللغة الألمانية.","أنا أقدر أطبخ الأكل.","أنا بشرب القهوة."],"note":"الجزء التاني من الدرس: الهوايات وأوقات الفراغ (Freizeit)."}},"grammar":[{"title":"الفعل مع «ich» (أنا)","rule":"مع «أنا» الفعل بياخد حرف e في الآخر. شيل الـ -en من المصدر وحط e: lernen ← ich lerne، machen ← ich mache.","examples":[{"de":"Ich lerne Deutsch.","ar":"أنا أتعلم الألماني."},{"de":"Ich koche heute.","ar":"أنا أطبخ النهاردة."}]},{"title":"Ich kann … (أنا أقدر)","rule":"بعد kann باقي الجملة بيمشي عادي، والفعل التاني بيروح في الآخر في المصدر (بالـ -en).","examples":[{"de":"Ich kann Deutsch sprechen.","ar":"أقدر أتكلم ألماني."},{"de":"Ich kann Gitarre spielen.","ar":"أقدر أعزف جيتار."}]},{"title":"ins = إلى الـ (للأماكن)","rule":"مع gehen وأماكن das بنقول ins: ins Kino، ins Café، ins Theater، ins Restaurant، ins Schwimmbad. هنا الفعل بعد ich بيبقى gehe، ومع kann بيبقى gehen في الآخر.","examples":[{"de":"Ich gehe ins Kino.","ar":"أنا رايح السينما."},{"de":"Ich kann ins Café gehen.","ar":"أقدر أروح الكافيه."}]},{"title":"spielen مع الألعاب والآلات","rule":"spielen معناها «يلعب» وكمان «يعزف». بعد kann: Ich kann Fußball spielen، Ich kann Klavier spielen.","examples":[{"de":"Ich kann Tennis spielen.","ar":"أقدر ألعب تنس."},{"de":"Ich kann Klavier spielen.","ar":"أقدر أعزف بيانو."}]},{"title":"الاسم: ich heiße / du heißt","rule":"السؤال: Wie heißt du؟ والرد: Ich heiße … أو Ich bin … مع حد كبير أو غريب بنقول Wie heißen Sie؟ (رسمي). du = إنت للصاحب، Sie = حضرتك.","examples":[{"de":"Wie heißt du?","ar":"اسمك إيه؟"},{"de":"Ich heiße Ali.","ar":"اسمي علي."}]}],"practice":{"build":[{"tiles":["Schach","kann","spielen","Ich"],"answer":"Ich kann Schach spielen."},{"tiles":["ins","Ich","Kino","gehe"],"answer":"Ich gehe ins Kino."},{"tiles":["hören","Musik","Ich","kann"],"answer":"Ich kann Musik hören."},{"tiles":["du","heißt","Wie"],"answer":"Wie heißt du?"},{"tiles":["gehen","kann","ins","Café","Ich"],"answer":"Ich kann ins Café gehen."},{"tiles":["Pizza","und","Ich","mache","ich","trinke","Saft"],"answer":"Ich mache Pizza und ich trinke Saft."}],"errors":[{"options":["Ich kann Fußball spiele.","Ich kann Fußball spielen."],"answer":1,"why":"بعد kann الفعل مصدر: spielen."},{"options":["Ich gehe in Kino.","Ich gehe ins Kino."],"answer":1,"why":"للأماكن مع gehen: ins Kino."},{"options":["Ich kann singe.","Ich kann singen."],"answer":1,"why":"بعد kann: singen (مصدر)."},{"options":["Ich lese Musik.","Ich höre Musik."],"answer":1,"why":"الموسيقى بتتسمع: höre."},{"options":["Ich heißen Ali.","Ich heiße Ali."],"answer":1,"why":"مع ich: heiße."},{"options":["Wie heiße du?","Wie heißt du?"],"answer":1,"why":"مع du: heißt."}],"translate":[{"ar":"أنا أقدر أرقص.","de":"Ich kann tanzen."},{"ar":"أنا رايح المطعم.","de":"Ich gehe ins Restaurant."},{"ar":"أنا بقرأ الجريدة.","de":"Ich lese die Zeitung."},{"ar":"أنا أقدر ألعب كرة سلة.","de":"Ich kann Basketball spielen."},{"ar":"أنا بسمع الراديو.","de":"Ich höre Radio."},{"ar":"اسمي علي. واسمك إيه؟","de":"Ich heiße Ali. Wie heißt du?"}]}}
