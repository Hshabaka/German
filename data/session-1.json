 "lesson": {
  "summary": "الجلسة دي أول خطوة: بتتعلم تكوّن جملة ألمانية كاملة عن نفسك من غير ما تحفظ قواعد معقدة. اتفرج على فيديو الدرس الأول، وبعدين اقرا القاعدة تحته، وبعدها كمّل التدريب اللي في الصفحة.",
  "challenge": {
   "title": "Writing challenge (Barbarys Schreib-Challenge) ✍️",
   "intro": "Translate these sentences into German:",
   "items": [
    "أنا أقدر أتعلم وأقرا وأكتب اللغة الألمانية.",
    "أنا أقدر أطبخ الأكل.",
    "أنا بشرب القهوة."
   ],
   "note": "Part two of the lesson: hobbies and free time (Freizeit)."
  }
 },
 "grammar": [
  {
   "title": "The verb after ich",
   "rule": "مع «أنا» بنشيل نهاية المصدر ونحط نهاية «أنا» مكانها. الشكل ده بيتكرر مع أغلب الأفعال في الدرس.",
   "forms": [
    "-en → -e",
    "lernen → ich lerne",
    "machen → ich mache",
    "kochen → ich koche"
   ],
   "examples": [
    {
     "de": "Ich lerne Deutsch.",
     "ar": "أنا أتعلم الألماني."
    },
    {
     "de": "Ich koche heute.",
     "ar": "أنا أطبخ النهاردة."
    }
   ]
  },
  {
   "title": "ich kann + verb",
   "rule": "بعد «أقدر» الفعل التاني بيروح آخر الجملة، وبيفضل بشكل المصدر (من غير تغيير). باقي الجملة بيتحط في النص.",
   "examples": [
    {
     "de": "Ich kann Deutsch sprechen.",
     "ar": "أقدر أتكلم ألماني."
    },
    {
     "de": "Ich kann Gitarre spielen.",
     "ar": "أقدر أعزف جيتار."
    }
   ]
  },
  {
   "title": "Going to a place (ins)",
   "rule": "قبل الأماكن دي بنقول ins، ومعناها «إلى الـ». ده للأماكن اللي أداتها das بس، والأماكن التانية هنتعلمها بعدين.",
   "forms": [
    "ins Kino",
    "ins Café",
    "ins Theater",
    "ins Restaurant",
    "ins Schwimmbad"
   ],
   "note": "بعد «أنا» بنقول gehe. وبعد «أقدر» بنقول gehen في آخر الجملة.",
   "examples": [
    {
     "de": "Ich gehe ins Kino.",
     "ar": "أنا رايح السينما."
    },
    {
     "de": "Ich kann ins Café gehen.",
     "ar": "أقدر أروح الكافيه."
    }
   ]
  },
  {
   "title": "The verb spielen",
   "rule": "نفس الفعل معناه «يلعب» مع الرياضة والألعاب، و«يعزف» مع الآلات الموسيقية.",
   "forms": [
    "Fußball spielen",
    "Tennis spielen",
    "Klavier spielen",
    "Gitarre spielen"
   ],
   "examples": [
    {
     "de": "Ich kann Tennis spielen.",
     "ar": "أقدر ألعب تنس."
    },
    {
     "de": "Ich kann Klavier spielen.",
     "ar": "أقدر أعزف بيانو."
    }
   ]
  },
  {
   "title": "Asking for a name",
   "rule": "مع صاحبك بتسأل بالسؤال الأول. ومع شخص كبير أو غريب بتسأل بالصيغة الرسمية (Sie) ومعناها «حضرتك». وفي الرد بتقول اسمك بعد ich heiße أو ich bin.",
   "examples": [
    {
     "de": "Wie heißt du?",
     "ar": "اسمك إيه؟"
    },
    {
     "de": "Wie heißen Sie?",
     "ar": "اسم حضرتك إيه؟"
    },
    {
     "de": "Ich heiße Ali.",
     "ar": "اسمي علي."
    },
    {
     "de": "Ich bin Ali.",
     "ar": "أنا علي."
    }
   ]
  }
 ],
