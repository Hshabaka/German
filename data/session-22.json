  "lesson": {
    "summary": "الجلسة دي بتعلمك تجاوب على Wann؟ بحروف الجر الزمنية: um للساعات، am للأيام وأوقات اليوم، im للشهور والفصول، von ... bis للفترات، مع ضمير ihr."
  },
  "grammar": [
    {
      "title": "um للساعات",
      "rule": "الساعات بتاخد um.",
      "forms": [
        "um acht Uhr",
        "um neun Uhr"
      ],
      "examples": [
        {
          "de": "Ich arbeite um acht Uhr.",
          "ar": "بشتغل الساعة 8."
        }
      ]
    },
    {
      "title": "am للأيام وأوقات اليوم",
      "rule": "الأيام وأوقات اليوم بتاخد am.",
      "forms": [
        "am Montag",
        "am Dienstag",
        "am Freitag",
        "am Morgen"
      ],
      "examples": [
        {
          "de": "Ich komme am Montag.",
          "ar": "هاجي الاثنين."
        },
        {
          "de": "Ihr reist am Freitag.",
          "ar": "بتسافروا الجمعة."
        }
      ]
    },
    {
      "title": "im للشهور والفصول",
      "rule": "الشهور والفصول بتاخد im.",
      "forms": [
        "im Sommer",
        "im August",
        "im Januar"
      ],
      "examples": [
        {
          "de": "Ich reise im Sommer.",
          "ar": "بسافر في الصيف."
        },
        {
          "de": "Ihr habt im Januar Urlaub.",
          "ar": "عندكم إجازة في يناير."
        }
      ]
    },
    {
      "title": "von ... bis للفترات",
      "rule": "لفترة من وقت لوقت: von ... bis.",
      "forms": [
        "von Montag bis Freitag",
        "von Dienstag bis Freitag"
      ],
      "examples": [
        {
          "de": "Ihr arbeitet von Dienstag bis Freitag.",
          "ar": "بتشتغلوا من الثلاثاء للجمعة."
        }
      ]
    }
  ],
