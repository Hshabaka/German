  "lesson": {
    "summary": "الجلسة دي بتعلمك تسأل عن المعنى (Was bedeutet das?)، تقول إنك مشغول، تدعو حد يجي معاك (Komm mit)، وتتكلم عن الطقس والفصول (Mir ist kalt / Es regnet)، مع مراجعة الدروس 1-21."
  },
  "grammar": [
    {
      "title": "Was bedeutet das؟ والانشغال",
      "rule": "Was bedeutet das? سؤال المعنى لما تسمع كلمة مش فاهمها. وللانشغال: Ich bin sehr / ein bisschen beschäftigt.",
      "forms": [
        "Was bedeutet das?",
        "Ich bin sehr beschäftigt",
        "Ich bin ein bisschen beschäftigt"
      ],
      "examples": [
        {
          "de": "Ich bin ein bisschen beschäftigt.",
          "ar": "أنا مشغول شوية."
        }
      ]
    },
    {
      "title": "Komm mit! الأمر من kommen",
      "rule": "لواحد: Komm mit! لجمع: Kommt mit! رسمي: Kommen Sie mit!",
      "forms": [
        "Komm mit!",
        "Kommt mit!",
        "Kommen Sie mit!"
      ],
      "examples": [
        {
          "de": "Kommt mit!",
          "ar": "تعالوا معايا!"
        }
      ]
    },
    {
      "title": "الطقس: Es regnet و Mir ist kalt",
      "rule": "الألماني مبيقولش \"أنا بارد\" بيقول \"البرد بالنسبة لي\": Mir ist kalt (Dativ). ومع هو: Ihm ist kalt. والمطر: Es regnet.",
      "forms": [
        "Ich → Mir ist kalt",
        "Er → Ihm ist kalt",
        "Es regnet"
      ],
      "examples": [
        {
          "de": "Mir ist kalt.",
          "ar": "أنا بردان."
        },
        {
          "de": "Ihm ist kalt.",
          "ar": "هو بردان."
        }
      ]
    },
    {
      "title": "مراجعة الدروس 1-21",
      "rule": "مراجعة: wie alt bist du؟ (bist)، als في المقارنة، helfen + Dativ (dem Mann/dem Kind)، damit، Wann/Wohin، muss ich بعد Leider، den للمذكر Akk، seine مع Tasche (مؤنث)، seit wann؟، lieber، ترتيب Sie müssen viel Wasser trinken، Das ist kein Balkon.",
      "forms": [
        "bist du",
        "teurer",
        "dem Mann",
        "damit",
        "muss ich",
        "den Kaffee",
        "seine Tasche",
        "seit wann",
        "lieber"
      ],
      "examples": [
        {
          "de": "Das Buch gehört den Kindern.",
          "ar": "الكتاب للأطفال."
        }
      ]
    }
  ],
