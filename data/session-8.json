  "lesson": {
    "summary": "الجلسة دي فيها تلات مكعبات كبار: الأفعال المنفصلة (anmachen/ausmachen اللي بتتقسم نصين)، وصيغة الأمر للمفرد (Mach!) والجمع (Macht!)، وأداة الربط damit (عشان) اللي بترمي الفعل آخر الجملة. مع مكعبات الأجهزة: das Licht، das Radio، das Tablet."
  },
  "grammar": [
    {
      "title": "الأفعال المنفصلة: anmachen / ausmachen",
      "rule": "أفعال بتتقسم نصين: الفعل مكانه التاني والجزء الثاني بيروح آخر الجملة: anmachen تبقى Ich mache das Licht an.",
      "forms": [
        "ich mache ... an",
        "ich mache ... aus"
      ],
      "examples": [
        {
          "de": "Ich mache das Licht an.",
          "ar": "أنا بفتح النور."
        },
        {
          "de": "Ich mache das Handy aus.",
          "ar": "أنا بقفل الموبايل."
        }
      ]
    },
    {
      "title": "صيغة الأمر للمفرد: Mach!",
      "rule": "عشان تدي أمر لشخص واحد (du) بنشيل الضمير والنهاية: Mach das Licht an!",
      "forms": [
        "Mach!",
        "Mach das Licht aus!"
      ],
      "examples": [
        {
          "de": "Mach das Licht an!",
          "ar": "افتح النور!"
        },
        {
          "de": "Mach das Handy aus!",
          "ar": "اقفل الموبايل!"
        }
      ]
    },
    {
      "title": "صيغة الأمر للجمع: Macht!",
      "rule": "مع أنتم (ihr) الفعل بياخد t في النهاية، والأمر هو نفس التصريف من غير الضمير: ihr macht تبقى Macht!",
      "forms": [
        "ihr macht → Macht!",
        "ihr müsst → المودال: müsst"
      ],
      "examples": [
        {
          "de": "Macht das Radio aus!",
          "ar": "اقفلوا الراديو!"
        },
        {
          "de": "Macht das Tablet an!",
          "ar": "افتحوا التابلت!"
        }
      ]
    },
    {
      "title": "damit: عشان / لكي",
      "rule": "damit بتربط السبب بالنتيجة وبترمي الفعل المتصرف في آخر الجملة تماماً: Mach das Licht aus, damit ich schlafen kann.",
      "forms": [
        "damit ich ... kann",
        "damit ihr ... könnt"
      ],
      "examples": [
        {
          "de": "Mach das Licht an, damit ich sehen kann.",
          "ar": "افتح النور عشان أقدر أشوف."
        },
        {
          "de": "Macht das Radio aus, damit ihr schlafen könnt.",
          "ar": "اقفلوا الراديو عشان تقدروا تناموا."
        }
      ]
    }
  ],
