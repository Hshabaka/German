  "lesson": {
    "summary": "الجلسة دي بتقفل لعبة الحالات: المحايد das (das / das / dem) والجمع die (die / die / den + n) مع الأفعال rufen وgehören."
  },
  "grammar": [
    {
      "title": "المحايد das",
      "rule": "Nominativ: das. Akkusativ: das (ثابت). Dativ: dem (زي المذكر).",
      "forms": [
        "das Kind → das Kind → dem Kind",
        "das Buch → das Buch → dem Buch"
      ],
      "examples": [
        {
          "de": "Das Kind lernt Deutsch.",
          "ar": "الطفل بيتعلم."
        },
        {
          "de": "Sie rufen das Kind.",
          "ar": "بينادوا الطفل."
        },
        {
          "de": "Das Buch gehört dem Kind.",
          "ar": "الكتاب للطفل."
        }
      ]
    },
    {
      "title": "الجمع die",
      "rule": "Nominativ: die. Akkusativ: die (ثابت). Dativ: den + حرف n في آخر الكلمة (Kindern).",
      "forms": [
        "die Kinder → die Kinder → den Kindern",
        "die Bücher → die Bücher → den Büchern"
      ],
      "examples": [
        {
          "de": "Die Kinder spielen hier.",
          "ar": "الأطفال بيلعبوا."
        },
        {
          "de": "Die Bücher gehören den Kindern.",
          "ar": "الكتب للأطفال."
        }
      ]
    },
    {
      "title": "rufen (Akk) و gehören (Dat)",
      "rule": "rufen: الفعل بيقع على الشيء → Akkusativ. gehören: الشيء مستفيد/صاحب → Dativ.",
      "forms": [
        "Sie rufen das Kind / die Kinder",
        "Das Buch gehört dem Kind",
        "Die Bücher gehören den Kindern"
      ],
      "examples": [
        {
          "de": "Das Auto gehört dem Mann.",
          "ar": "العربية للرجل."
        }
      ]
    },
    {
      "title": "الملخص: كل الأدوات في 3 حالات",
      "rule": "مذكر: der / den / dem. مؤنث: die / die / der. محايد: das / das / dem. جمع: die / die / den + n.",
      "forms": [
        "der / den / dem",
        "die / die / der",
        "das / das / dem",
        "die / die / den + n"
      ],
      "examples": [
        {
          "de": "Wir sehen die Kinder und wir helfen den Kindern.",
          "ar": "بنشوف الأطفال وبنساعدهم."
        }
      ]
    }
  ],
