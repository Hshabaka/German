  "lesson": {
    "summary": "أهم درس في الألماني: عالم الأسماء والأدوات. der/das في النكرة بتبقى ein وفي النفي kein، وdie بتحب حرف e: eine وkeine. بنطبق على السكن والأثاث: das Zimmer، das Bad، die Küche، das Bett، der Balkon، وبنوصف بيتنا بـ groß/klein/hell/dunkel."
  },
  "grammar": [
    {
      "title": "der و das: ein و kein",
      "rule": "الكلمات المذكرة (der) والمحايدة (das) في النكرة بتاخد ein وفي النفي kein: Das ist ein Tisch / Das ist kein Haus.",
      "forms": [
        "der → ein → kein",
        "das → ein → kein"
      ],
      "examples": [
        {
          "de": "Das ist ein Tisch.",
          "ar": "دي ترابيزة."
        },
        {
          "de": "Das ist kein Haus.",
          "ar": "ده مش منزل."
        }
      ]
    },
    {
      "title": "die: eine و keine",
      "rule": "الأداة die بتحب حرف الـ e: في النكرة eine وفي النفي keine: Das ist eine Wohnung / Das ist keine Wohnung.",
      "forms": [
        "die → eine → keine"
      ],
      "examples": [
        {
          "de": "Das ist eine Wohnung.",
          "ar": "دي شقة."
        },
        {
          "de": "Das ist keine Wohnung.",
          "ar": "دي مش شقة."
        }
      ]
    },
    {
      "title": "معرفة أو نكرة؟",
      "rule": "لو بنتكلم عن حاجة محددة بنستخدم der/die/das: Die Wohnung ist sehr groß. لو حاجة عامة أول مرة نذكرها: ein/eine: Wir kaufen ein Haus.",
      "forms": [
        "محددة: der/die/das",
        "عامة: ein/eine"
      ],
      "examples": [
        {
          "de": "Die Wohnung ist sehr groß und hell.",
          "ar": "الشقة كبيرة جداً ومنورة."
        },
        {
          "de": "Wir kaufen ein Haus.",
          "ar": "احنا بنشتري منزل."
        }
      ]
    },
    {
      "title": "التعويض عن das بـ es",
      "rule": "الكلمة اللي أداتها das بنعوض عنها بـ es: Das ist das Bad. Es ist klein, aber schön.",
      "forms": [
        "das Bad → es",
        "das Haus → es"
      ],
      "examples": [
        {
          "de": "Das ist das Bad. Es ist klein, aber schön.",
          "ar": "ده الحمام. صغير بس جميل."
        },
        {
          "de": "Das Haus ist teuer, aber wir kaufen es.",
          "ar": "المنزل غالي، بس احنا هنشتريه."
        }
      ]
    }
  ],
