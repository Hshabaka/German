  "lesson": {
    "summary": "الجلسة دي بتعلمك المكان: Wohin؟ (حركة، Akkusativ) وWo؟ (ثبات، Dativ) مع auf وin وan، وأفعال legen/liegen وsitzen وwarten auf، وdanach."
  },
  "grammar": [
    {
      "title": "auf: أماكن مفتوحة وأسطح",
      "rule": "auf = على/في مكان مفتوح أو سطح. حركة → Akkusativ (auf den Markt). ثبات → Dativ (auf dem Markt). وضع شيء على سطح: auf den Tisch.",
      "forms": [
        "Ich gehe auf den Markt.",
        "Ich bin auf dem Markt.",
        "Ich lege das Buch auf den Tisch.",
        "Wir gehen auf eine Party / Ich bin auf YouTube / Insta"
      ],
      "examples": [
        {
          "de": "Ich gehe auf den Markt.",
          "ar": "رايح السوق."
        },
        {
          "de": "Ich bin auf dem Markt.",
          "ar": "في السوق."
        }
      ]
    },
    {
      "title": "auf مع أفعال ثابتة (Akkusativ دايمًا)",
      "rule": "warten auf و sich freuen auf بعدهم Akkusativ. تعبيرات: Auf jeden Fall = بالتأكيد، Auf Wiedersehen = إلى اللقاء.",
      "forms": [
        "Ich warte auf dich.",
        "Er freut sich auf das Wochenende.",
        "Auf jeden Fall",
        "Auf Wiedersehen"
      ],
      "examples": [
        {
          "de": "Ich warte auf dich, weil ich Zeit habe.",
          "ar": "مستنيك لأن عندي وقت."
        }
      ]
    },
    {
      "title": "in و an: مغلق وعند",
      "rule": "in للأماكن المغلقة. حركة → Akkusativ (in den Supermarkt)، ثبات → Dativ (im Zimmer = in dem Zimmer). an = جنب/عند: Ich sitze am Tisch (an dem). Ich gehe an die Tür.",
      "forms": [
        "in den Supermarkt / im Supermarkt",
        "in die Wohnung / in der Wohnung",
        "am Tisch",
        "an die Tür"
      ],
      "examples": [
        {
          "de": "Ich gehe in den Supermarkt.",
          "ar": "رايح السوبرماركت."
        },
        {
          "de": "Ich bin im Zimmer.",
          "ar": "في الأوضة."
        }
      ]
    },
