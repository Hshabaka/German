  "lesson": {
    "summary": "الجلسة دي بتعلمك تلغي موعد رسمي بالأفعال المنفصلة (absagen) مع müssen/können، وتتكلم عن نفسك وعن زميلك، مع مراجعة شاملة للدروس 1-14."
  },
  "grammar": [
    {
      "title": "الفعل المنفصل absagen",
      "rule": "absagen بيتقسم: الفعل المتصرف في المركز 2 (sage/sagt) والجزء ab في آخر الجملة.",
      "forms": [
        "Ich sage diesen Termin ab.",
        "Er sagt diesen Termin ab."
      ],
      "examples": [
        {
          "de": "Ich sage diesen Termin ab.",
          "ar": "أنا بلغي الموعد ده."
        },
        {
          "de": "Er sagt diesen Termin ab.",
          "ar": "هو بيلغي الموعد ده."
        }
      ]
    },
    {
      "title": "müssen / können + المصدر",
      "rule": "مع الفعل المساعد، absagen يرجع قطعة واحدة في الآخر. تصريف er = تصريف ich: muss/kann.",
      "forms": [
        "Ich muss ... absagen",
        "Er muss ... absagen",
        "Er kann ... nicht kommen"
      ],
      "examples": [
        {
          "de": "Leider muss ich diesen Termin absagen.",
          "ar": "للأسف لازم ألغي."
        },
        {
          "de": "Er kann heute nicht ins Büro kommen.",
          "ar": "ما يقدرش ييجي."
        }
      ]
    },
    {
      "title": "Leider والمركز التاني",
      "rule": "بعد Leider الفعل المتصرف لازم ييجي رقم 2 وبعدين الفاعل: Leider kann ich ... / Leider muss er ...",
      "forms": [
        "Leider kann ich heute nicht kommen.",
        "Leider muss er diesen Termin absagen."
      ],
      "examples": [
        {
          "de": "Leider kann er dieses Mal nicht arbeiten.",
          "ar": "للأسف ما يقدرش يشتغل."
        }
      ]
    },
    {
      "title": "مراجعة الدروس 1-15",
      "rule": "مراجعة: kann مع ich، für + mich (Akkusativ)، damit = لكي، kein مع المذكر، als للمقارنة، Mein مع المذكر، lieber، Sie (جمع) = möchten.",
      "forms": [
        "Ich kann",
        "für mich",
        "damit",
        "kein Balkon",
        "Die Wohnung ist größer als das Zimmer"
      ],
      "examples": [
        {
          "de": "Er spielt Fußball lieber als Tennis.",
          "ar": "بيفضل الكورة عن التنس."
        }
      ]
    }
  ],
