  "lesson": {
    "summary": "الجلسة دي بتثبّت الأرقام من null لحد hundert وبتعلّمك تقول عمرك صح بـ bin (مش habe - الغلطة المشهورة)، وتسأل اللي قدامك عن سنه وتليفونه وعنوانه ومهنته بضمير du، مع أدوات der/die لكلمات المهن والبيانات."
  },
  "grammar": [
    {
      "title": "bin / bist مع العمر (أوعى habe!)",
      "rule": "في الألماني العمر بيتقال بفعل \"يكون\": Ich bin 20 Jahre alt. استخدام habe (يمتلك) مع العمر غلطة شائعة جدًا.",
      "forms": [
        "ich bin",
        "du bist",
        "er/sie ist"
      ],
      "examples": [
        {
          "de": "Ich bin 20 Jahre alt.",
          "ar": "عمري 20 سنة."
        },
        {
          "de": "Du bist 25 Jahre alt.",
          "ar": "عمرك 25 سنة."
        }
      ]
    },
    {
      "title": "أسئلة للي قدامك بضمير du",
      "rule": "عشان تسأل الشخص اللي قدامك: Wie + ist + deine + الاسم للأشياء، و Wie/Was + bist + du للشخص نفسه.",
      "forms": [
        "Wie alt bist du?",
        "Wie ist deine Telefonnummer?",
        "Wie ist deine Adresse?",
        "Was bist du von Beruf?"
      ],
      "examples": [
        {
          "de": "Wie ist deine Adresse?",
          "ar": "إيه عنوانك؟"
        },
        {
          "de": "Was bist du von Beruf?",
          "ar": "إيه مهنتك؟"
        }
      ]
    },
    {
      "title": "als = \"كـ / بصفة\" مع المهن",
      "rule": "لما تقول إن حد شغال في مهنة: arbeiten + als + المهنة من غير أداة.",
      "forms": [
        "Du arbeitest als Ingenieur."
      ],
      "examples": [
        {
          "de": "Du arbeitest als Ingenieur.",
          "ar": "انت شغال كمهندس."
        }
      ]
    },
    {
      "title": "von Beruf = كمهنة",
      "rule": "von Beruf بتيجي بعد المهنة عشان تقول \"دي وظيفته\": Du bist Verkäufer von Beruf.",
      "forms": [
        "Was bist du von Beruf?",
        "Du bist Verkäufer von Beruf.",
        "Sie ist Ärztin von Beruf."
      ],
      "examples": [
        {
          "de": "Du bist Verkäufer von Beruf.",
          "ar": "وظيفتك بائع."
        },
        {
          "de": "Sie ist Ärztin von Beruf.",
          "ar": "هي دكتورة كمهنة."
        }
      ]
    }
  ],
