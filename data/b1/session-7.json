  "lesson": {
    "summary": "الحلقة ٧ من B1: أفعال مع حروف جر ثابتة والحالة اللي بعدها (أكوزاتيف ولا داتيف). auf/über/um/gegen أكوزاتيف، zu/von/mit/nach/aus/in/bei/an داتيف، والفرق بين freuen auf وüber وبين arbeiten an/bei/in. (تلات فيديوهات - صياغة تعليمية مراجعة على التسجيلات الأصلية؛ المدرس بيشير لـ PDF تمارين على Barbary مش مرفوع هنا)"
  },
  "grammar": [
    {
      "title": "الفعل + حرف الجر = حزمة واحدة",
      "rule": "فيه أفعال لازم حرف جر معين عشان المعنى يكمل، زي wait for في الإنجليزي. احفظ الفعل مع حرفه وحالته كحزمة، واتعلم الجملة كلها مرة واحدة.",
      "forms": [
        "warten auf",
        "träumen von",
        "bestehen aus"
      ],
      "examples": [
        {
          "de": "Ich warte auf dich.",
          "ar": "بستناك."
        }
      ]
    },
    {
      "title": "الحالة من حرف الجر مش الفعل",
      "rule": "حرف الجر هو اللي بيحدد أكوزاتيف ولا داتيف. أكوزاتيف: auf, über, um, gegen. داتيف: zu, von, mit, nach, aus, in, bei, an. المدرس كرر النقطة دي في الفيديوهين الأول والتاني.",
      "forms": [
        "auf + Akkusativ",
        "mit + Dativ"
      ],
      "examples": [
        {
          "de": "Sie wartet auf einen Anruf.",
          "ar": "هي مستنية مكالمة."
        },
        {
          "de": "Kann ich dich zu einem Kaffee einladen?",
          "ar": "أقدر أدعيك على قهوة؟"
        }
      ]
    },
    {
      "title": "freuen auf ولا über",
      "rule": "auf لحاجة لسه جاية في المستقبل، über لحاجة حصلت أو موجودة دلوقتي.",
      "forms": [
        "sich freuen auf (مستقبل)",
        "sich freuen über (دلوقتي)"
      ],
      "examples": [
        {
          "de": "Wir freuen uns auf das Wochenende.",
          "ar": "فرحانين بالويك إند اللي جاي."
        },
        {
          "de": "Ich freue mich über das Geschenk.",
          "ar": "فرحان بالهدية."
        }
      ]
    },
    {
      "title": "arbeiten an / bei / in",
      "rule": "an = مشروع شغال عليه، bei = موظف عند شركة، in = المكان اللي بتشتغل فيه. التلاتة متشابهين ومحتاجين تركيز.",
      "forms": [
        "arbeiten an",
        "arbeiten bei",
        "arbeiten in"
      ],
      "examples": [
        {
          "de": "Ich arbeite an meinem neuen Projekt.",
          "ar": "بشتغل على المشروع الجديد بتاعي."
        },
        {
          "de": "Ich arbeite bei der Post.",
          "ar": "أنا موظف في البريد."
        }
      ]
    },
    {
      "title": "حدود الحلقة",
      "rule": "القايمة دي أفعال الفيديوهات التلاتة بس (٩ + ١٥)، وفيه أفعال كتير تانية ممكن تيجي فيديوهات جاية. المدرس بيشير لـ PDF تمارين على Barbary (مش مرفوع هنا). الجمل صياغة تعليمية مراجعة على التسجيلات.",
      "forms": [
        "حفظ كحزمة: فعل + حرف + حالة"
      ],
      "examples": [
        {
          "de": "Ich beneide sie um ihre Geduld.",
          "ar": "بحسدها على صبرها."
        }
      ]
    }
  ],
