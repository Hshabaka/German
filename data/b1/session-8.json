  "lesson": {
    "summary": "الحلقة ٨ من B1: ظروف حروف الجر - كلمة واحدة بدل حرف الجر للأشياء (darauf/woran)، تريكة حرف r، وفخ العاقل وغير العاقل. مع أهم أفعال B1 اللي ليها حرف جر ثابت."
  },
  "grammar": [
    {
      "title": "الفكرة: كلمة واحدة بدل حرف الجر",
      "rule": "للأشياء (غير العاقل): دا + حرف الجر في الرد (darauf/daran/darüber)، وWo + حرف الجر في السؤال (worauf/woran/worüber).",
      "forms": [
        "darauf - drauf",
        "worauf - على إيه"
      ],
      "examples": [
        {
          "de": "Ich warte auf den Bus. - Ich warte darauf.",
          "ar": "بستنى الأوتوبيس - بستناه."
        },
        {
          "de": "Worauf wartest du?",
          "ar": "بتستنى إيه؟"
        }
      ]
    },
    {
      "title": "حرف r السحري",
      "rule": "لو حرف الجر بيبدأ بحرف متحرك (a/o/u...) لازم r في النص عشان النطق: darauf وdarüber وdarin وworan.",
      "forms": [
        "auf - darauf",
        "über - darüber",
        "an - daran",
        "in - darin"
      ],
      "examples": [
        {
          "de": "Ich denke daran.",
          "ar": "بفكر فيه."
        }
      ]
    },
    {
      "title": "فخ B1: العاقل وغير العاقل",
      "rule": "للأشخاص ممنوع Da-/Wo-: بنسأل بحرف الجر + wen/wem ونرد بحرف الجر + ضمير: Auf wen wartest du? - Auf ihn.",
      "forms": [
        "Auf wen? - auf ihn",
        "An wen? - an Ali"
      ],
      "examples": [
        {
          "de": "An wen denkst du? - An meinen Freund Ali.",
          "ar": "بتفكر في مين؟ في صاحبي علي."
        }
      ]
    },
    {
      "title": "احفظ الفعل بحرف الجر بتاعه",
      "rule": "freuen auf (مستقبل) وfreuen über (حصل) وärgern über وerinnern an وkonzentrieren auf وkümmern um وträumen von وbeschweren über وbedanken für وAngst vor.",
      "forms": [
        "sich freuen auf/über",
        "sich kümmern um",
        "Angst haben vor"
      ],
      "examples": [
        {
          "de": "Ich freue mich sehr darauf.",
          "ar": "مبسوط أوي بيها (جاية)."
        },
        {
          "de": "Ich habe mich sehr darüber gefreut.",
          "ar": "فرحت أوي بيها (حصلت)."
        }
      ]
    }
  ],
