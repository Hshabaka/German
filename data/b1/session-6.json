  "lesson": {
    "summary": "الحلقة ٦ من B1: التمني والنصيحة والندم (Konjunktiv II). würde مع الأفعال العادية، hätte للملكية، wäre للكينونة، صيغ الشكلية könnte/müsste/sollte/dürfte/wollte/möchte، والندم على الماضي بـ hätte/wäre + التصريف التالت."
  },
  "grammar": [
    {
      "title": "würden: التمني مع أي فعل عادي",
      "rule": "würde + المصدر في الآخر = ياريت + الفعل. التصريف: würde/würdest/würde/würden/würdet/würden.",
      "forms": [
        "ich würde",
        "du würdest",
        "wir würden"
      ],
      "examples": [
        {
          "de": "Ich würde gerne ein neues Auto kaufen.",
          "ar": "ياريتني أشتري عربية جديدة."
        },
        {
          "de": "Wir würden gerne eine Weltreise machen.",
          "ar": "ياريتنا نعمل رحلة حول العالم."
        }
      ]
    },
    {
      "title": "hätte و wäre: مباشرة من غير würden",
      "rule": "للملكية استخدم hätte (ياريت كان عندي) وللكينونة والمكان wäre (ياريتني كنت) مباشرة.",
      "forms": [
        "ich hätte gerne Geld",
        "ich wäre gerne in Berlin"
      ],
      "examples": [
        {
          "de": "Ich hätte gerne viel Geld.",
          "ar": "ياريت كان معايا فلوس كتير."
        },
        {
          "de": "Ich wäre jetzt gerne zu Hause.",
          "ar": "ياريتني في البيت دلوقتي."
        }
      ]
    },
    {
      "title": "الشكلية في الـ Konjunktiv II",
      "rule": "können←könnte، müssen←müsste، sollen←sollte (نصيحة)، dürfen←dürfte، wollen←wollte، mögen←möchte.",
      "forms": [
        "könnte - könntest",
        "müsste",
        "sollte",
        "dürfte",
        "wollte",
        "möchte"
      ],
      "examples": [
        {
          "de": "Du solltest mehr Wasser trinken.",
          "ar": "المفروض تشرب مية أكتر."
        },
        {
          "de": "Ich wollte fragen, ob du Zeit hast.",
          "ar": "كنت حابب أسأل لو عندك وقت."
        }
      ]
    },
    {
      "title": "الندم على الماضي",
      "rule": "hätte/wäre في المركز التاني + التصريف التالت في الآخر. أفعال الحركة تاخد wäre والباقي hätte.",
      "forms": [
        "hätte ... gelernt",
        "wäre ... gefahren"
      ],
      "examples": [
        {
          "de": "Ich hätte dich angerufen.",
          "ar": "ياريتني كنت اتصلت بيك."
        },
        {
          "de": "Ich wäre pünktlich gekommen.",
          "ar": "ياريتني كنت جيت في الميعاد."
        }
      ]
    },
    {
      "title": "الطلب المؤدب جدًا",
      "rule": "Dürfte ich...؟ وKönntest du...؟ وIch wollte fragen... - أسلوب أرقى للطلبات.",
      "forms": [
        "Dürfte ich kurz stören?",
        "Könntest du das Fenster zumachen?"
      ],
      "examples": [
        {
          "de": "Dürfte ich kurz stören?",
          "ar": "ممكن أزعجك لحظة؟"
        }
      ]
    }
