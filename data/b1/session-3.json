  "lesson": {
    "summary": "الحلقة ٣ من B1: إزاي تحط فعل تاني في الجملة. 18 فعل وتركيب بياخدوا zu في الآخر (مع تريكة الأفعال المنفصلة auszugehen)، والـ VIP اللي مبياخدوش zu: الشكلية والحركة والحواس وlassen."
  },
  "grammar": [
    {
      "title": "قاعدة zu: الفعل التاني",
      "rule": "لما ييجي فعل تاني بعد الأفعال دي، بيروح الآخر في المصدر مع zu. والفعل المنفصل zu بتتحشر في النص: auszumachen, einzukaufen.",
      "forms": [
        "beginnen, ... zu machen",
        "vergessen, ... auszumachen"
      ],
      "examples": [
        {
          "de": "Ich beginne, Deutsch zu lernen.",
          "ar": "ببدأ أتعلم ألماني."
        },
        {
          "de": "Er hat vergessen, das Licht auszumachen.",
          "ar": "نسي يطفي النور."
        }
      ]
    },
    {
      "title": "الـ 18: أفعال وتراكيب بتاخد zu",
      "rule": "beginnen وversuchen وvergessen وbeschließen وplanen وhoffen وhelfen وanbieten وvorschlagen وversprechen وraten وverbieten وdenken an، وتراكيب bereit/erlaubt/gesund sein وZeit/Lust haben.",
      "forms": [
        "Ich habe Zeit, dich zu besuchen.",
        "Er bietet an, Tee zu trinken."
      ],
      "examples": [
        {
          "de": "Wir beschließen, eine Reise zu machen.",
          "ar": "قررنا نعمل رحلة."
        },
        {
          "de": "Der Vater verbietet, das Handy zu benutzen.",
          "ar": "الأب بيمنع استخدام الموبايل."
        }
      ]
    },
    {
      "title": "الـ VIP: بدون zu",
      "rule": "الأفعال الشكلية (wollen/müssen...) وأفعال الحركة (gehen) والحواس (hören/sehen) وlassen وbleiben: الفعل التاني من غير zu.",
      "forms": [
        "Ich will das Auto kaufen.",
        "Ich gehe schlafen.",
        "Ich lasse das Auto reparieren."
      ],
      "examples": [
        {
          "de": "Ich höre das Baby weinen.",
          "ar": "سامع البيبي بيعيط."
        },
        {
          "de": "Ich bleibe heute im Bett schlafen.",
          "ar": "هفضل نايم في السرير النهارده."
        }
      ]
    },
    {
      "title": "تريكة الأفعال المنفصلة في الامتحان",
      "rule": "anbieten وvorschlagen أفعال منفصلة: الكومة بتتفرق في الآخرين — Er bietet an, uns zu helfen. وausgehen + zu = auszugehen.",
      "forms": [
        "anbieten: an ... zu helfen",
        "ausgehen: auszugehen"
      ],
      "examples": [
        {
          "de": "Er bietet an, das Auto zu kaufen.",
          "ar": "هو بيعرض يشتري العربية."
        },
        {
          "de": "Ich schlage vor, am Samstag auszugehen.",
          "ar": "بقترح نخرج يوم السبت."
        }
      ]
    }
  ],
