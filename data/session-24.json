  "lesson": {
    "summary": "الجلسة دي بتعلمك المستقبل: الطريقة الرسمية (werden + مصدر في الآخر) ولغة الشارع (مضارع + كلمة وقت)، وربط الأحداث بـ sobald (الفعل في الآخر)، مع عيد الميلاد. ملاحظة: جمل التمرين الأخيرة (مثل «Ich lerne morgen Deutsch, sobald ich aufwache.») جمل تدريب مؤلفة على نمط الدرس، وليست منقولة حرفيًا من ملف الدرس."
  },
  "grammar": [
    {
      "title": "المستقبل الرسمي Futur I",
      "rule": "werden في المركز التاني + المصدر في آخر الجملة.",
      "forms": [
        "ich werde",
        "du wirst",
        "wir werden"
      ],
      "examples": [
        {
          "de": "Ich werde morgen arbeiten.",
          "ar": "هشتغل بكرة."
        },
        {
          "de": "Wir werden nächste Woche ins Kino gehen.",
          "ar": "هنروح السينما الأسبوع الجاي."
        }
      ]
    },
    {
      "title": "لغة الشارع: مضارع + كلمة وقت",
      "rule": "الألمان نادرًا ما يستخدموا werden: بيستخدموا المضارع العادي + heute / morgen / nächste Woche.",
      "forms": [
        "Ich werde heute einkaufen → Ich gehe heute einkaufen",
        "Du wirst feiern → Du feierst morgen"
      ],
      "examples": [
        {
          "de": "Ich gehe heute einkaufen.",
          "ar": "هروح أتسوق."
        },
        {
          "de": "Du feierst morgen deinen Geburtstag.",
          "ar": "هتحتفل بكرة."
        }
      ]
    },
    {
      "title": "sobald = أول ما",
      "rule": "sobald أداة ربط زي weil: بترمي الفعل المتصرف في آخر الجملة.",
      "forms": [
        "..., sobald ich Zeit habe",
        "..., sobald das Wetter schön ist",
        "..., sobald du Geld hast"
      ],
      "examples": [
        {
          "de": "Du kaufst das Geschenk, sobald du Geld hast.",
          "ar": "هتشتري الهدية أول ما يبقى معاك فلوس."
        }
      ]
    }
  ],
