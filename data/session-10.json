  "lesson": {
    "summary": "درس التتويج: بقيت تقدر تقدم نفسك كاملاً — Ich heiße، Ich bin 20 Jahre alt، Ich komme aus، Ich wohne in، Ich bin Lehrer. وكمان تقدم غيرك بضمير هي (Sie): sie heißt، sie kommt، sie spricht. مع مكعبات الحالة الاجتماعية (ledig/verheiratet) واللغات."
  },
  "grammar": [
    {
      "title": "التعريف بالنفس: heißen و sein",
      "rule": "الاسم بـ heißen: Ich heiße Abdelrahman. والعمر والمهنة بـ sein: Ich bin 20 Jahre alt، Ich bin Lehrer.",
      "forms": [
        "ich heiße",
        "ich bin ... Jahre alt",
        "ich bin + مهنة"
      ],
      "examples": [
        {
          "de": "Ich heiße Abdelrahman.",
          "ar": "اسمي عبدالرحمن."
        },
        {
          "de": "Ich bin 20 Jahre alt.",
          "ar": "عندي ٢٠ سنة."
        }
      ]
    },
    {
      "title": "kommen aus و wohnen in",
      "rule": "البلد اللي جاي منها: kommen aus (Ich komme aus Ägypten). والسكن: wohnen in (Ich wohne in Kairo).",
      "forms": [
        "ich komme aus + بلد",
        "ich wohne in + مدينة"
      ],
      "examples": [
        {
          "de": "Ich komme aus Ägypten.",
          "ar": "أنا من مصر."
        },
        {
          "de": "Ich wohne in Kairo.",
          "ar": "أنا ساكن في القاهرة."
        }
      ]
    },
    {
      "title": "sie (هي): الفعل ياخد t",
      "rule": "مع هي بنغير نهاية الفعل العادي بـ t: Ich komme تبقى Sie kommt، Ich wohne تبقى Sie wohnt، Ich bin تبقى Sie ist.",
      "forms": [
        "ich komme → sie kommt",
        "ich wohne → sie wohnt",
        "ich bin → sie ist"
      ],
      "examples": [
        {
          "de": "Sie kommt aus Ägypten.",
          "ar": "هي من مصر."
        },
        {
          "de": "Sie spricht Arabisch und Englisch.",
          "ar": "هي بتتكلم عربي وإنجليزي."
        }
      ]
    },
    {
      "title": "kein: نفي الاسم",
      "rule": "عشان ننفي اسم (زي الأطفال) بنستخدم keine: Sie hat keine Kinder (ماعندهاش أطفال).",
      "forms": [
        "kein + اسم",
        "keine Kinder"
      ],
      "examples": [
        {
          "de": "Sie hat keine Kinder.",
          "ar": "هي ماعندهاش أطفال."
        },
        {
          "de": "Sie ist verheiratet und sie hat Kinder.",
          "ar": "هي متزوجة وعندها أطفال."
        }
      ]
    }
  ],
