  "lesson": {
    "summary": "الجلسة دي بتعلمك نوعين الأسئلة: نعم/لا (الفعل في الأول) وأسئلة W (أداة + فعل + فاعل)، بصيغة du وبصيغة Sie الرسمية، مع موضوع وقت الفراغ."
  },
  "grammar": [
    {
      "title": "أسئلة نعم/لا: حركة المقص",
      "rule": "بنجيب الفعل في أول الجملة وبعده الفاعل: Du arbeitest heute. → Arbeitest du heute?",
      "forms": [
        "Du arbeitest heute.",
        "Arbeitest du heute?"
      ],
      "examples": [
        {
          "de": "Arbeiten Sie am Wochenende?",
          "ar": "هل حضرتك بتشتغل في الويك إند؟"
        }
      ]
    },
    {
      "title": "أسئلة W: أداة + فعل + فاعل",
      "rule": "أداة الاستفهام في الأول وبعدها الفعل فورًا وبعدين الفاعل.",
      "forms": [
        "Wo = فين",
        "Wohin = لفين",
        "Wann = إمتى",
        "Warum = ليه",
        "Was = إيه"
      ],
      "examples": [
        {
          "de": "Wo arbeitest du?",
          "ar": "فين بتشتغل؟"
        },
        {
          "de": "Wohin gehst du?",
          "ar": "رايح فين؟"
        },
        {
          "de": "Wann kommst du?",
          "ar": "هتيجي إمتى؟"
        }
      ]
    },
    {
      "title": "الصيغة الرسمية مع Sie",
      "rule": "مع Sie الفعل بيفضل بالمصدر (en): arbeiten، besuchen، lernen، machen. نفس الترتيب في الأسئلتين.",
      "forms": [
        "Arbeiten Sie ...?",
        "Wo besuchen Sie ...?",
        "Was machen Sie ...?"
      ],
      "examples": [
        {
          "de": "Warum lernen Sie zusammen Deutsch?",
          "ar": "ليه بتتعلموا ألماني مع بعض؟"
        },
        {
          "de": "Wann arbeiten Sie zusammen?",
          "ar": "إمتى بتشتغلوا مع بعض؟"
        }
      ]
    }
  ],
