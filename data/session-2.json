 "lesson": {
  "summary": "الجلسة دي بتخلّي جملتك فيها «روح». هتتعلم تقول إن حاجة سهلة أو غالية أو حلوة، وتربط فكرتين بـ und و aber، وتنفي بـ nicht. اتفرج على الفيديو، وبعدين اقرا القواعد تحته، وكمّل التدريب في الصفحة.",
  "challenge": {
   "title": "Writing challenge (Barbarys Schreib-Challenge) ✍️",
   "intro": "Translate these sentences into German:",
   "items": [
    "أنا بتعلم ألماني وده سهل جدًا بالنسبة لي، لكن مش سهل جدًا بالنسبة لك.",
    "أنا بتكلم ألماني وده رائع جدًا بالنسبة لي، لكن ده صعب بالنسبة لك.",
    "القهوة رخيصة وكويسة."
   ],
   "note": "Use the pattern: Das ist (nicht) (sehr) adjective (für mich / für dich)."
  }
 },
 "grammar": [
  {
   "title": "Das ist (nicht) (sehr) adjective",
   "rule": "ده القالب الأساسي للجلسة. بتبدأ بـ Das ist، وبعدين تضيف sehr أو nicht لو عايز، وبعدها الصفة، وفي الآخر لو عايز تقول لمين: für mich أو für dich.",
   "forms": [
    "Das ist einfach",
    "Das ist sehr einfach",
    "Das ist nicht sehr einfach",
    "Das ist sehr einfach für mich"
   ],
   "examples": [
    {
     "de": "Das ist einfach.",
     "ar": "ده سهل."
    },
    {
     "de": "Das ist nicht sehr einfach für dich.",
     "ar": "ده مش سهل قوي بالنسبة لك."
    }
   ]
  },
  {
   "title": "nicht and sehr",
   "rule": "الاتنين بيتحطوا قبل الصفة على طول. sehr بتقوّيها (جدًا)، و nicht بتنفيها (مش).",
   "forms": [
    "sehr teuer",
    "nicht teuer",
    "nicht sehr teuer"
   ],
   "note": "الصفة بعد ist بتفضل زي ما هي، من غير أي تغيير.",
   "examples": [
    {
     "de": "Das ist sehr teuer.",
     "ar": "ده غالي جدًا."
    },
    {
     "de": "Das ist nicht teuer.",
     "ar": "ده مش غالي."
    }
   ]
  },
  {
   "title": "und and aber",
   "rule": "und معناها «و» وبتربط حاجتين زي بعض. aber معناها «لكن» وبتربط حاجتين عكس بعض. بعد الاتنين ترتيب الجملة بيفضل عادي، والفعل في المركز التاني.",
   "forms": [
    "gut und billig",
    "schön, aber teuer"
   ],
   "examples": [
    {
     "de": "Der Kaffee ist gut und billig.",
     "ar": "القهوة كويسة ورخيصة."
    },
    {
     "de": "Das ist schön, aber teuer.",
     "ar": "ده جميل بس غالي."
    }
   ]
  },
  {
   "title": "für mich, für dich, mit mir, mit dir",
   "rule": "بتقول لمين الكلام ينطبق بـ für: für mich (ليا)، für dich (ليك). وبتقول «مع مين» بـ mit: mit mir (معايا)، mit dir (معاك).",
   "forms": [
    "für mich",
    "für dich",
    "mit mir",
    "mit dir"
   ],
   "examples": [
    {
     "de": "Das ist wichtig für mich.",
     "ar": "ده مهم بالنسبة لي."
    },
    {
     "de": "Ich spiele mit dir.",
     "ar": "أنا بلعب معاك."
    }
   ]
  },
  {
   "title": "Opposites and nouns with articles",
   "rule": "احفظ الصفات في أزواج عكس بعض، فكل كلمة بتفكّرك بعكسها. وللأسماء احفظ الأداة معاها: der أو die أو das.",
   "forms": [
    "einfach ↔ schwierig",
    "teuer ↔ billig",
    "schön ↔ hässlich",
    "gut ↔ schlecht",
    "groß ↔ klein",
    "neu ↔ alt"
   ],
   "examples": [
    {
     "de": "Das Auto ist neu.",
     "ar": "العربية جديدة."
    },
    {
     "de": "Die Pizza ist wirklich lecker.",
     "ar": "البيتزا لذيذة فعلًا."
    }
   ]
  }
 ],
