  "lesson": {
    "summary": "الجلسة دي بتعلمك تطلب موعد عند الدكتور بأدب (Ich hätte gerne)، وتوصف الألم (العضو + Schmerzen)، وتجاوب على seit wann، مع haben مع sie/er ومراجعة الدروس 1-16."
  },
  "grammar": [
    {
      "title": "طلب موعد بأدب",
      "rule": "Ich hätte gerne ... تعبير مؤدب. مع sie: Sie hätte gerne ... من غير تغيير. والسؤال: Wie kann ich Ihnen helfen?",
      "forms": [
        "Ich hätte gerne einen Termin bei Ihnen.",
        "Sie hätte gerne einen Termin."
      ],
      "examples": [
        {
          "de": "Ich hätte gerne einen Termin bei Ihnen.",
          "ar": "أود موعد عندكم."
        }
      ]
    },
    {
      "title": "الألم = العضو + Schmerzen",
      "rule": "بنجيب اسم العضو وبنلزق Schmerzen: Kopf+schmerzen، Bauch+schmerzen، Hals+schmerzen، Rücken+schmerzen.",
      "forms": [
        "Kopfschmerzen",
        "Bauchschmerzen",
        "Halsschmerzen",
        "Rückenschmerzen"
      ],
      "examples": [
        {
          "de": "Sie hat seit gestern Halsschmerzen.",
          "ar": "عندها ألم حلق من إمبارح."
        }
      ]
    },
    {
      "title": "haben مع Sie/sie/er",
      "rule": "مع Sie الرسمية: haben. مع sie (هي) وer: hat. وhätte gerne بتفضل زي ما هي.",
      "forms": [
        "Sie haben",
        "sie hat",
        "er hat"
      ],
      "examples": [
        {
          "de": "Welche Beschwerden hat sie?",
          "ar": "إيه شكواها؟"
        }
      ]
    },
    {
      "title": "seit wann؟ seit + مدة",
      "rule": "السؤال: Seit wann ...? والرد: Seit zwei Tagen / Seit gestern. ملاحظة ترتيب الجملة: ملف الدرس (PDF 16-2) بيقول إن المدة تيجي قبل العرض: Ich habe seit zwei Tagen Bauchschmerzen. ده الترتيب الطبيعي اللي بنتدرب عليه. الترتيب التاني (Ich habe Bauchschmerzen seit zwei Tagen) كمان صحيح نحويًا لأن ترتيب الجملة في الألماني ميل مش قانون صارم (مصدر: deutschplus.net/pages/Satzgliedstellung)، بس احنا بنستخدم ترتيب الملف.",
      "forms": [
        "Seit wann haben Sie Schmerzen?",
        "Seit zwei Tagen",
        "Seit gestern"
      ],
      "examples": [
        {
          "de": "Ich habe seit zwei Tagen Bauchschmerzen.",
          "ar": "عندي ألم بطن من يومين."
        }
      ]
    },
    {
      "title": "مراجعة الدروس 1-16: damit",
      "rule": "damit = لكي وبيرمي الفعل المتصرف في الآخر: Mach das Licht an, damit ich lesen kann. وwir: müssen.",
      "forms": [
        "..., damit ich lesen kann",
        "Wir müssen den Termin absagen"
      ],
      "examples": [
        {
          "de": "Mach das Licht an, damit ich lesen kann.",
          "ar": "شغل النور عشان أقدر أقرا."
        }
      ]
    }
  ],
