 "lesson": {
  "summary": "تالت حلقة في المستوى التاني: خططنا اتلغت! هتتعلم تعتذر وتلغي وتأجل معاد من غير ما تزعل حد، باستخدام روابط المركز صفر الخمسة (ADUSO): aber وdenn وund وsondern وoder، وتبني جمل طويلة فيها سبب وتناقض وتصحيح."
 },
 "grammar": [
  {
   "title": "روابط المركز صفر (ADUSO)",
   "rule": "الروابط دي (aber, denn, und, sondern, oder) كوبري بين جملتين ومتغيرش ترتيب الجملة اللي بعدها: الفاعل الأول وبعدين الفعل المصرّف في المركز التاني زي أي جملة عادية.",
   "forms": [
    "aber",
    "denn",
    "und",
    "sondern",
    "oder"
   ],
   "examples": [
    {
     "de": "Ich komme nicht, denn ich bin krank.",
     "ar": "مش هاجي عشان أنا مريض."
    }
   ]
  },
  {
   "title": "denn: السبب",
   "rule": "denn بتربط سبب بنتيجة: الجملة اللي بعدها بتقول ليه.",
   "forms": [
    "..., denn + جملة عادية"
   ],
   "examples": [
    {
     "de": "Ich muss mich beeilen, denn ich habe einen Termin.",
     "ar": "لازم أستعجل عشان عندي معاد."
    },
    {
     "de": "Wir gehen spazieren, denn das Wetter ist schön.",
     "ar": "هنتمشى عشان الجو حلو."
    }
   ]
  },
  {
   "title": "aber: التناقض",
   "rule": "aber بتعبر عن تناقض أو حاجة غير متوقعة بعد الجملة الأولى.",
   "forms": [
    "..., aber + جملة عادية"
   ],
   "examples": [
    {
     "de": "Ich habe Zeit, aber ich bin sehr müde.",
     "ar": "عندي وقت، لكن أنا متعب جدًا."
    }
   ]
  },
  {
   "title": "oder و sondern: التخيير والتصحيح",
   "rule": "oder للتخيير بين بديلين (غالبًا في الأسئلة). sondern لتصحيح معلومة، ولازم يكون قبلها جملة منفية بـ nicht أو kein.",
   "forms": [
    "oder",
    "nicht/kein ..., sondern ..."
   ],
   "examples": [
    {
     "de": "Gehen wir ins Kino, oder bleiben wir zu Hause?",
     "ar": "نروح السينما ولا نقعد في البيت؟"
    },
    {
     "de": "Wir treffen uns nicht heute, sondern morgen.",
     "ar": "مش هنتقابل النهاردة، بل بكرة."
    }
   ]
  }
 ],
