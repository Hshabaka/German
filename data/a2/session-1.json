 "lesson": {
  "summary": "أول حلقة في المستوى التاني: روتين الصباح والأفعال المنعكسة. هتتعلم تتكلم عن الغسيل واللبس والحلاقة وتمشيط الشعر، والمكعب الجديد الكبير: الفرق بين mich/mir و dich/dir — لو الفعل واقع عليك كلك يبقى أكوزاتيف، ولو فيه جزء منك أو حاجة محددة يبقى داتيف، وساعتها ممنوع mein/dein مع أجزاء الجسم."
 },
 "grammar": [
  {
   "title": "الأفعال المنعكسة (Reflexive Verben)",
   "rule": "أفعال الشخص بيعملها على نفسه. الضمير المنعكس بيتصرف حسب الفاعل: ich/mich-mir، du/dich-dir، وهو ثابت (sich) مع er/sie/es وSie، و(uns) مع wir، و(euch) مع ihr.",
   "forms": [
    "ich — mich / mir",
    "du — dich / dir",
    "er/sie/es/Sie — sich",
    "wir — uns",
    "ihr — euch"
   ],
   "examples": [
    {
     "de": "Ich wasche mich.",
     "ar": "أنا أغتسل."
    },
    {
     "de": "Wir beeilen uns.",
     "ar": "إحنا بنستعجل."
    }
   ]
  },
  {
   "title": "القاعدة 1: الفعل واقع عليك كلك = Akkusativ",
   "rule": "لو مفيش مفعول به في الجملة، يبقى الفعل واقع عليك أنت كلّك، والضمير المنعكس ياخد الأكوزاتيف: mich / dich / sich.",
   "forms": [
    "mich",
    "dich",
    "sich"
   ],
   "examples": [
    {
     "de": "Ich ziehe mich an.",
     "ar": "أنا بلبس ملابسي."
    },
    {
     "de": "Warum beeilst du dich so sehr?",
     "ar": "ليه بتستعجل كده؟"
    }
   ]
  },
  {
   "title": "القاعدة 2: فيه مفعول أو جزء منك = Dativ",
   "rule": "لو فيه حاجة محددة في الجملة (مفعول به)، هي اللي تاخد الأكوزاتيف، والضمير المنعكس يتزحلق للداتيف: mir / dir / sich.",
   "forms": [
    "mir",
    "dir",
    "sich"
   ],
   "examples": [
    {
     "de": "Ich wasche mir den Kopf.",
     "ar": "أنا بغسل دماغي."
    },
    {
     "de": "Ich ziehe mir den Pullover an.",
     "ar": "أنا بلبس البلوفر."
    }
   ]
  },
  {
   "title": "تريكة: ممنوع mein / dein مع أجزاء الجسم",
   "rule": "لما تستخدم الضمير المنعكس في الداتيف (mir/dir) إنت كده حددت إن الحاجة بتاعتك، فممنوع تستخدم أدوات الملكية مع أجزاء الجسم أو الملابس، ويكفي أداة التعريف العادية (der/die/das).",
   "forms": [
    "✘ meinen Kopf",
    "✔ den Kopf",
    "✘ seine Hände",
    "✔ die Hände"
   ],
   "examples": [
    {
     "de": "Ich wasche mir den Kopf.",
     "ar": "أنا بغسل دماغي."
    },
    {
     "de": "Er wäscht sich die Hände.",
     "ar": "هو بيغسل إيديه."
    }
   ]
  }
 ],
