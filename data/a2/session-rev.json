  "lesson": {
    "summary": "مراجعة شاملة على الدروس من 1 لـ 5 بمحاكاة امتحان جوته: الأفعال المنعكسة، الأفعال الشكلية، الروابط الخمسة، أسماء الإشارة dieser/welcher، وأدوات الملكية في الأكوزاتيف. مع نص قراءة وتحدي ترجمة مترابط."
  },
  "grammar": [
    {
      "title": "الأفعال المنعكسة: mich وال mir؟",
      "rule": "اسأل نفسك: فيه مفعول (حاجة تانية) في الجملة؟ لو آه يبقى الضمير داتيف (mir/dir)، لو لأ يبقى أكوزاتيف (mich/dich).",
      "forms": [
        "ich - mich/mir",
        "du - dich/dir",
        "er/sie/es - sich",
        "wir - uns"
      ],
      "examples": [
        {
          "de": "Ich wasche mich.",
          "ar": "بغتسل."
        },
        {
          "de": "Ich putze mir die Zähne.",
          "ar": "بغسل سناني."
        }
      ]
    },
    {
      "title": "الأفعال الشكلية والكماشة",
      "rule": "müssen لازم، können يقدر، wollen عايز. الفعل الشكلي يتصرف في مكان الفعل، والفعل الأصلي يروح الآخر في المصدر.",
      "forms": [
        "ich kann",
        "du musst",
        "wir wollen"
      ],
      "examples": [
        {
          "de": "Ich muss heute arbeiten.",
          "ar": "لازم اشتغل النهارده."
        },
        {
          "de": "Wollen wir uns am Wochenende treffen?",
          "ar": "عايزين نتقابل في الويك إند؟"
        }
      ]
    },
    {
      "title": "الروابط الخمسة",
      "rule": "denn للسبب، aber للتناقض، oder للتخيير، sondern للتصحيح بعد النفي، und للإضافة. وكلهم مبيأثروش في ترتيب الجملة.",
      "forms": [
        "denn - لأن",
        "aber - لكن",
        "sondern - بل",
        "oder - أو",
        "und - و"
      ],
      "examples": [
        {
          "de": "Ich kann nicht kommen, denn ich muss arbeiten.",
          "ar": "مش هقدر ايجي، لأني لازم اشتغل."
        },
        {
          "de": "Wir treffen uns nicht heute, sondern morgen.",
          "ar": "مش هنتقابل النهارده، بل بكرة."
        }
      ]
    },
    {
      "title": "dieser/welcher والملكية في الأكوزاتيف",
      "rule": "dies- و welch- بياخدوا نهايات الأداة: dieser/welcher للمذكر، وفي الأكوزاتيف diesen/welchen. والملكية زيها: mein يبقى meinen مع المذكر بس.",
      "forms": [
        "dieser Mantel",
        "diesen Mantel",
        "meinen Onkel"
      ],
      "examples": [
        {
          "de": "Welchen Pullover ziehst du dir an?",
          "ar": "هتلبس أنهي بلوفر؟"
        },
        {
          "de": "Ich bringe meinen Bruder mit.",
          "ar": "هجيب أخويا معايا."
        }
      ]
    }
  ],
