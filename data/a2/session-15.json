     "ar": "المفتاح في الشنطة."
    },
    {
     "de": "Die Katze schläft unter dem Bett.",
     "ar": "القطة نايمة تحت السرير."
    }
   ]
  },
  {
   "title": "الأداة في الداتيف والدمج",
   "rule": "der/das تبقى dem، die تبقى der، الجمع den + n. والدمج: in+dem=im وan+dem=am.",
   "forms": [
    "auf dem Tisch",
    "neben der Lampe",
    "zwischen den Stühlen",
    "im Wohnzimmer",
    "am Fenster"
