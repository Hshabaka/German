 "sentences": [
  {
   "de": "Wo ist mein Schlüssel?",
   "ar": "مفتاحي فين؟",
   "audio": "audio/a2/s15/s01-wo-ist-mein-schluessel.mp3"
  },
  {
   "de": "Er liegt auf dem Tisch im Flur.",
   "ar": "على الترابيزة في الطرقة.",
   "audio": "audio/a2/s15/s02-er-liegt-auf-dem-tisch-im-flur.mp3"
  },
  {
   "de": "Wo steht der Fernseher?",
   "ar": "التلفزيون فين؟",
   "audio": "audio/a2/s15/s03-wo-steht-der-fernseher.mp3"
  },
  {
   "de": "Das Bild hängt an der Wand über dem Sofa.",
   "ar": "الصورة متعلقة على الحيطة فوق الكنبة.",
   "audio": "audio/a2/s15/s04-das-bild-haengt-an-der-wand-ueber-dem-sofa.mp3"
  },
  {
   "de": "Ich bin in der Küche.",
   "ar": "أنا في المطبخ.",
   "audio": "audio/a2/s15/s05-ich-bin-in-der-kueche.mp3"
  },
  {
   "de": "Das Bett steht am Fenster.",
   "ar": "السرير جنب الشباك.",
   "audio": "audio/a2/s15/s06-das-bett-steht-am-fenster.mp3"
  },
  {
   "de": "Der Schlüssel liegt in der Tasche.",
   "ar": "المفتاح في الشنطة.",
   "audio": "audio/a2/s15/s07-der-schluessel-liegt-in-der-tasche.mp3"
  },
  {
   "de": "Die Katze schläft unter dem Bett.",
   "ar": "القطة نايمة تحت السرير.",
   "audio": "audio/a2/s15/s08-die-katze-schlaeft-unter-dem-bett.mp3"
  },
  {
   "de": "Das Auto steht vor dem Haus.",
   "ar": "العربية واقفة قدام البيت.",
   "audio": "audio/a2/s15/s09-das-auto-steht-vor-dem-haus.mp3"
  },
  {
   "de": "Der Tisch steht zwischen dem Sofa und dem Fenster.",
   "ar": "الترابيزة واقفة بين الكنبة والشباك.",
   "audio": "audio/a2/s15/s10-der-tisch-steht-zwischen-dem-sofa-und-dem-fe.mp3"
  },
  {
   "de": "Ich lege das Buch auf den Tisch.",
   "ar": "بحط الكتاب على الترابيزة.",
   "audio": "audio/a2/s15/s11-ich-lege-das-buch-auf-den-tisch.mp3"
  },
  {
   "de": "Das Buch liegt auf dem Tisch.",
   "ar": "الكتاب نايم على الترابيزة.",
   "audio": "audio/a2/s15/s12-das-buch-liegt-auf-dem-tisch.mp3"
  },
  {
   "de": "Wohin stellen wir das Sofa?",
   "ar": "نحط الكنبة فين؟",
   "audio": "audio/a2/s15/s13-wohin-stellen-wir-das-sofa.mp3"
  },
  {
   "de": "Wohin soll ich den Karton tragen?",
   "ar": "أشيل الكرتونة فين؟",
   "audio": "audio/a2/s15/s14-wohin-soll-ich-den-karton-tragen.mp3"
  },
  {
   "de": "Ich stelle den Schreibtisch ans Fenster.",
   "ar": "بحط المكتب جنب الشباك.",
   "audio": "audio/a2/s15/s15-ich-stelle-den-schreibtisch-ans-fenster.mp3"
  },
  {
   "de": "Ich habe die Uhr an die Wand gehängt.",
   "ar": "علّقت الساعة على الحيطة.",
   "audio": "audio/a2/s15/s16-ich-habe-die-uhr-an-die-wand-gehaengt.mp3"
  },
  {
   "de": "Wir stellen die Waschmaschine in den Keller.",
   "ar": "هنحط الغسالة في البدروم.",
   "audio": "audio/a2/s15/s17-wir-stellen-die-waschmaschine-in-den-keller.mp3"
  },
  {
   "de": "Ich habe das Handy auf das Sofa gelegt, und jetzt liegt es auf dem Sofa.",
   "ar": "حطيت الموبايل على الكنبة، ودلوقتي هو نايم عليها.",
   "audio": "audio/a2/s15/s18-ich-habe-das-handy-auf-das-sofa-gelegt-und-j.mp3"
  },
  {
   "de": "Mein Zimmer ist klein, aber gemütlich.",
   "ar": "أوضتي صغيرة، لكن مريحة.",
   "audio": "audio/a2/s15/s19-mein-zimmer-ist-klein-aber-gemuetlich.mp3"
  },
  {
   "de": "Der Schrank ist schwer, deshalb tragen wir ihn zusammen in den Keller.",
   "ar": "الدولاب تقيل، عشان كده هنشيله مع بعض للبدروم.",
   "audio": "audio/a2/s15/s20-der-schrank-ist-schwer-deshalb-tragen-wir-ih.mp3"
  }
 ],
