 "lesson": {
  "summary": "خامس حلقة في المستوى التاني: عائلتي وأشيائي. هتتعلم أدوات الملكية كلها (mein/dein/sein/ihr/unser/euer) وإمتى تضيف -en: لو الفعل واقع على كلمة مذكرة. وهتتكلم عن عيلتك وممتلكاتك بسهولة."
 },
 "grammar": [
  {
   "title": "القاعدة الذهبية: وصف ولا فعل؟",
   "rule": "لو الشيء بيوصف (فاعل) يبقى Nominativ ومفيش تغيير. لو الفعل واقع عليه (مفعول به) يبقى Akkusativ، والمذكر بس هو اللي بياخد النهاية -en.",
   "forms": [
    "Nominativ: mein Vater ist nett",
    "Akkusativ: ich besuche meinen Vater"
   ],
   "examples": [
    {
     "de": "Mein Kaffee ist heiß.",
     "ar": "قهوتي سخنة."
    },
    {
     "de": "Ich trinke meinen Kaffee.",
     "ar": "بشرب قهوتي."
    }
   ]
  },
  {
   "title": "جدول أدوات الملكية",
   "rule": "mein/dein/sein/ihr/unser/euer/Ihr حسب المالك. في الأكوزاتيف المذكر بس يضاف -en (meinen/deinen/seinen...)، والمؤنث والمحايد والجمع زي ما هما.",
   "forms": [
    "ich: mein/meinen",
    "du: dein/deinen",
    "er: sein/seinen",
    "sie: ihr/ihren",
    "wir: unser/unseren"
   ],
   "examples": [
    {
     "de": "Ali repariert sein Auto.",
     "ar": "علي بيصلح عربيته."
    },
    {
     "de": "Sara ruft ihren Bruder an.",
     "ar": "سارة بتكلم أخوها."
    }
   ]
  },
  {
   "title": "sein ولا ihr؟",
   "rule": "sein لما المالك ولد (هو)، وihr لما المالكة بنت (هي). النهاية بعد كده حسب الكلمة المملوكة.",
   "forms": [
    "sein- (ملكه)",
    "ihr- (ملكها)"
   ],
   "examples": [
    {
     "de": "Herr Müller trinkt seinen Kaffee.",
     "ar": "الأستاذ مولر بيشرب قهوته."
    },
    {
     "de": "Frau Schmidt isst ihre Pizza.",
     "ar": "الست شميدت بتاكل بيتزاها."
    }
   ]
  },
  {
   "title": "المؤنث والمحايد ثابتين",
   "rule": "die وdas والجمع في الأكوزاتيف زي النوميناتيف بالظبط، مفيش أي تغيير. التغيير بيحصل في der بس.",
   "forms": [
    "die - meine",
    "das - mein",
    "Pl. - meine"
   ],
   "examples": [
    {
     "de": "Ich esse meine Pizza.",
     "ar": "باكل البيتزا بتاعتي."
    },
    {
     "de": "Ahmed findet sein Buch nicht.",
     "ar": "أحمد مش لاقي كتابه."
    }
   ]
  }
 ],
