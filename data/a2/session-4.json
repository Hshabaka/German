 "lesson": {
  "summary": "رابع حلقة في المستوى التاني: هذا أم أي؟ هتتعلم تسأل وتجاوب بأدوات الإشارة والاستفهام (dies- وwelch-) بنفس النهايات، وتعوّض عن الكلمة المكررة بالضمير الصح (ihn/es/sie)، وتتسوق وتقيّم حاجات بنجوم."
 },
 "grammar": [
  {
   "title": "Dies- و -Welch: التوأم",
   "rule": "أداة الإشارة (dies-) وأداة الاستفهام (-welch) توأم، نفس النهايات بالظبط. النهاية بتعتمد على النوع (der/die/das/جمع) والحالة (Nom وصف / Akk مفعول / Dat مستفيد-تقييم).",
   "forms": [
    "der: -er / -en / -em",
    "die: -e / -e / -er",
    "das: -es / -es / -em",
    "Pl.: -e / -e / -en"
   ],
   "examples": [
    {
     "de": "Welchen Pullover kaufst du? - Ich kaufe diesen Pullover.",
     "ar": "بتشتري أنهي بلوفر؟ - بشتري البلوفر ده."
    },
    {
     "de": "Welcher Pizza gibst du fünf Sterne? - Ich gebe dieser Pizza fünf Sterne.",
     "ar": "بتدي أنهي بيتزا خمس نجوم؟ - بادي البيتزا دي خمس نجوم."
    }
   ]
  },
  {
   "title": "النهايات الملونة اللي لازم تتحفظ",
   "rule": "خمس نهايات بس: er وen وem وe وes. في الأكوزاتيف المذكر بس هو اللي بيتغير (-en)، والباقي زي الأصل.",
   "forms": [
    "-er",
    "-en",
    "-em",
    "-e",
    "-es"
   ],
   "examples": [
    {
     "de": "Ich kaufe diesen Tisch.",
     "ar": "بشتري الترابيزة دي."
    },
    {
     "de": "Dieses Hemd ist neu.",
     "ar": "القميص ده جديد."
    }
   ]
  },
  {
   "title": "ضمائر التعويض في الأكوزاتيف",
   "rule": "عشان منكررش الكلمة، بنعوّض عنها بضمير: der تبقى ihn، وdas تبقى es، وdie (مفرد أو جمع) تبقى sie.",
   "forms": [
    "der - ihn",
    "das - es",
    "die/Pl. - sie"
   ],
   "examples": [
    {
     "de": "Wo ist der Mantel? Ich suche ihn.",
     "ar": "فين البالطو؟ بدور عليه."
    },
    {
     "de": "Das T-Shirt ist schön. Ich kaufe es.",
     "ar": "التيشيرت جميل. هشتريه."
    }
   ]
  },
  {
   "title": "gefällt: فعل الإعجاب بالداتيف",
   "rule": "gefallen فعل بيطلب داتيف من نفسه: الحاجة هي الفاعل، وإنت اللي في الداتيف: Das gefällt mir (ده عجبني).",
   "forms": [
    "Das gefällt mir",
    "Das gefällt dir"
   ],
   "examples": [
    {
     "de": "Dieses Kleid gefällt mir.",
     "ar": "الفستان ده عجبني."
    }
   ]
  }
 ],
