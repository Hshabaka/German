 "lesson": {
  "summary": "تاني حلقة في المستوى التاني: جدول المواعيد الزحمة والأفعال الشكلية. هتتعلم تعتذر بأدب بكلمة leider، وتحدد التزاماتك بالوقت، وتقترح معاد بسؤال Wollen wir uns treffen. والمكعب الكبير: قاعدة الكماشة، الفعل الشكلي في المركز التاني والفعل الأساسي في النهاية."
 },
 "grammar": [
  {
   "title": "الأفعال الشكلية: قاعدة الكماشة",
   "rule": "الفعل الشكلي هو المدير: بيتصرّف ويجي في المركز التاني، وبياخد الفعل الأساسي يرميه في نهاية الجملة في المصدر من غير تصريف.",
   "forms": [
    "müssen",
    "können",
    "wollen",
    "dürfen",
    "sollen"
   ],
   "examples": [
    {
     "de": "Ich muss heute arbeiten.",
     "ar": "لازم أشتغل النهاردة."
    },
    {
     "de": "Ich kann am Freitag leider nicht kommen.",
     "ar": "للأسف مش أقدر أجي يوم الجمعة."
    }
   ]
  },
  {
   "title": "سؤال الاقتراح",
   "rule": "الفعل الشكلي في المركز الأول والفعل الأساسي في النهاية، وماتنساش تصريف الضمير المنعكس (sich treffen ← uns مع wir).",
   "forms": [
    "Wollen wir uns ... treffen?"
   ],
   "examples": [
    {
     "de": "Wollen wir uns um 19 Uhr treffen?",
     "ar": "عايزين نتقابل الساعة 7؟"
    },
    {
     "de": "Wollen wir uns am Montag treffen?",
     "ar": "نتقابل يوم الاتنين؟"
    }
   ]
  },
  {
   "title": "صياعة الألمان: حذف فعل الحركة",
   "rule": "لو السياق فيه اتجاه لمكان معروف، ممكن نحذف فعل الحركة (gehen/fahren) خالص، ودي الصيغة الأصح والأكثر استخدامًا.",
   "forms": [
    "Ich muss zum Arzt.",
    "Ich muss zum Arzt gehen."
   ],
   "examples": [
    {
     "de": "Ich muss zum Arzt.",
     "ar": "لازم أروح للدكتور."
    }
   ]
  },
  {
   "title": "أدوات الوقت",
   "rule": "um مع الساعات، am مع الأيام وأجزاء اليوم، von ... bis لتحديد المدة.",
   "forms": [
    "um 19 Uhr",
    "am Freitag",
    "von 8 bis 16 Uhr"
   ],
   "examples": [
    {
     "de": "Ich muss heute von 8 bis 16 Uhr arbeiten.",
     "ar": "لازم أشتغل النهاردة من 8 لـ 4."
    }
   ]
  }
 ],
