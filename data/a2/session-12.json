  "lesson": {
    "summary": "الحلقة ١٢ من A2: مصطلحات طبية أساسية. الوجع = العضو + Schmerzen، zum وzur، Warum وSeit wann، وحوار عند الدكتور بـ weil وdeshalb. (محتوى من الفيديو بدون PDF - صياغة تعليمية مراجعة على التسجيل الأصلي)"
  },
  "grammar": [
    {
      "title": "الوجع = العضو + Schmerzen",
      "rule": "الراس + الآلام = الصداع: der Kopf + die Schmerzen = die Kopfschmerzen. والبطن + الآلام = die Bauchschmerzen.",
      "forms": [
        "die Kopfschmerzen",
        "die Bauchschmerzen"
      ],
      "examples": [
        {
          "de": "Ich habe Kopfschmerzen.",
          "ar": "عندي صداع."
        }
      ]
    },
    {
      "title": "zum و zur",
      "rule": "رايح لـ: zum للمذكر والمحايد (zum Arzt)، zur للمؤنث (zur Apotheke). قطعة جاهزة.",
      "forms": [
        "zum Arzt",
        "zur Apotheke"
      ],
      "examples": [
        {
          "de": "Ich gehe zur Apotheke.",
          "ar": "أنا رايح الصيدلية."
        }
      ]
    },
    {
      "title": "Warum? و Seit wann?",
      "rule": "ليه = Warum، من إمتى = Seit wann، والرد: seit gestern. ولو الجملة بدأت بـ seit gestern الفعل تاني كلمة.",
      "forms": [
        "Warum?",
        "Seit wann?",
        "Seit gestern."
      ],
      "examples": [
        {
          "de": "Seit gestern habe ich Bauchschmerzen.",
          "ar": "من إمبارح بطني بتوجعني."
        }
      ]
    },
    {
      "title": "weil و deshalb",
      "rule": "نفس قاعدة الحلقتين ١٠ و١١: الفعل في الآخر بعد weil، وبعد deshalb الفعل تاني كلمة.",
      "forms": [
        "..., weil ich krank bin.",
        "Deshalb gehe ich zum Arzt."
      ],
      "examples": [
        {
          "de": "Ich trinke keinen Kaffee. Deshalb habe ich Kopfschmerzen.",
          "ar": "مش بشرب قهوة. عشان كده عندي صداع."
        }
      ]
    }
  ],
