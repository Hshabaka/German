  "lesson": {
    "summary": "الجلسة دي بتعلمك ماضي الحكايات السريع (Präteritum) لفعلين بس: war (كان) وhatte (كان عنده)، مع ich وwir، وبتحكي عن ذكريات الطفولة."
  },
  "grammar": [
    {
      "title": "war: ماضي sein",
      "rule": "bin → war. مع wir: waren. ماضي الحكايات السريع (Präteritum) بنركز فيه على فعلين بس: war وhatte.",
      "forms": [
        "ich bin → ich war",
        "wir sind → wir waren"
      ],
      "examples": [
        {
          "de": "Ich war gestern in Berlin.",
          "ar": "كنت إمبارح في برلين."
        },
        {
          "de": "Wir waren sehr glücklich.",
          "ar": "كنا سعداء."
        }
      ]
    },
    {
      "title": "hatte: ماضي haben",
      "rule": "habe → hatte. مع wir: hatten. وبعده Akkusativ زي haben: einen Hund، keinen Stress.",
      "forms": [
        "ich habe → ich hatte",
        "wir haben → wir hatten"
      ],
      "examples": [
        {
          "de": "Wir hatten einen Hund.",
          "ar": "كان عندنا كلب."
        },
        {
          "de": "Wir hatten keinen Stress.",
          "ar": "ما كانش عندنا توتر."
        }
      ]
    },
    {
      "title": "Perfekt ولا Präteritum؟",
      "rule": "الدرس اللي فات: Perfekt لأحداث (إحنا عملنا إيه). النهارده: war وhatte بس لوصف كنا فين وكان عندنا إيه.",
      "forms": [
        "Perfekt: Ich habe gespielt",
        "Präteritum: Ich war / Ich hatte"
      ],
      "examples": [
        {
          "de": "Ich war beim Arzt und ich hatte Angst.",
          "ar": "كنت عند الدكتور وخايف."
        }
      ]
    }
  ],
