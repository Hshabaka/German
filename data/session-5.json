  "lesson": {
    "summary": "الجلسة دي بتضيف أفعال الضرورة والرغبة: muss (لازم)، will (عايز)، soll (ينبغي) جنب kann اللي اتعلمناه. وفي الجزء التاني بتفتح ضمير جديد: wir (احنا)، ومعاه كلمات السفر: reisen وfliegen وfahren. اتفرج على فيديو الدرس الخامس، راجع الجداول تحته، وبعدين كمّل التدريب.",
    "challenge": {
      "title": "Writing challenge (Barbarys Schreib-Challenge) ✍️",
      "intro": "Translate these sentences into German:",
      "items": [
        "لازم أشتري التذكرة النهاردة.",
        "احنا نقدر نطير مع العيلة في الويك إند.",
        "المية غالية، بس لازم أشتريها."
      ],
      "note": "Build 3 long sentences with 'Wir können / Wir müssen ... und / aber das ist ... für uns' and the adjectives toll, langweilig, billig, teuer."
    }
  },
  "grammar": [
    {
      "title": "muss, kann, will, soll: أفعال الضرورة والرغبة",
      "rule": "أربع أفعال مودالية بتتحط مكان الفعل المصرف: muss (لازم)، kann (أقدر)، will (عايز)، soll (ينبغي). والفعل الأساسي بيروح آخر الجملة في المصدر.",
      "forms": [
        "ich muss / du musst / er muss",
        "ich kann / du kannst / er kann",
        "ich will / du willst / er will",
        "ich soll / du sollst / er soll"
      ],
      "examples": [
        {
          "de": "Ich muss das Ticket kaufen.",
          "ar": "لازم أشتري التذكرة."
        },
        {
          "de": "Ich will das Handy kaufen.",
          "ar": "عايز أشتري الموبايل."
        }
      ]
    },
    {
      "title": "ترتيب الجملة مع الأفعال المودالية",
      "rule": "الفعل المودال (muss/kann/will/soll) بيتصرف في مكانه التاني في الجملة، والفعل الأساسي بيروح الآخر خالص في شكل المصدر: Ich muss jetzt Deutsch sprechen.",
      "forms": [
        "Ich muss es lernen.",
        "Ich muss es bezahlen.",
        "Ich kann nach Deutschland reisen.",
        "Wir können nicht reisen."
      ],
      "examples": [
        {
          "de": "Das ist nicht billig, aber ich muss es bezahlen.",
          "ar": "ده مش رخيص بس لازم أدفع تمنه."
        },
        {
          "de": "Entschuldigung, das ist schwer, aber ich muss es lernen.",
          "ar": "معلش، ده صعب بس لازم أتعلمه."
        }
      ]
    },
    {
      "title": "wir: الفعل بيرجع للمصدر",
      "rule": "مع الضمير wir (احنا) الفعل بيفضل زي المصدر بينتهي بـ -en، يعني مفيش تعب في التصريف: ich reise بس wir reisen، وich kann بس wir können.",
      "forms": [
        "ich reise → wir reisen",
        "ich kann → wir können",
        "ich muss → wir müssen",
        "ich fliege → wir fliegen"
      ],
      "examples": [
        {
          "de": "Wir reisen nach Deutschland.",
          "ar": "احنا بنسافر ألمانيا."
        },
        {
          "de": "Wir fliegen heute mit der Familie.",
          "ar": "هنطير النهاردة مع العيلة."
        }
      ]
    },
    {
      "title": "reisen, fliegen, fahren: إزاي بتسافر",
      "rule": "reisen = يسافر بشكل عام، fliegen = يسافر بالطيران، fahren = يسافر بالسيارة أو القطار. ومعاهم كلمات الزمان: heute (النهاردة) و am Wochenende (الويك إند).",
      "forms": [
        "Ich reise nach Deutschland.",
        "Wir fliegen heute.",
        "Wir fahren am Wochenende.",
        "Wir reisen mit der Familie."
      ],
      "examples": [
        {
          "de": "Wir können nicht am Wochenende reisen.",
          "ar": "مش نقدر نسافر في الويك إند."
        },
        {
          "de": "Wir fahren heute, aber das ist sehr teuer.",
          "ar": "هنروح بالعربية النهاردة، بس ده غالي جدًا."
        }
      ]
    }
  ],
