  "lesson": {
    "summary": "الجلسة دي بتكسر عقدة الحالات: Nominativ للوصف، Akkusativ لما الفعل بيقع على الشيء (den)، Dativ للمستفيد (dem)، بالمنطق مش بالحفظ، مع المذكر وwir."
  },
  "grammar": [
    {
      "title": "Nominativ: الوصف",
      "rule": "لما بتوصف الشيء أو بتتكلم عنه، بيفضل في حالته الأساسية والمذكر بيفضل der.",
      "forms": [
        "der Mann",
        "der Hund"
      ],
      "examples": [
        {
          "de": "Der Mann ist hier.",
          "ar": "الرجل هنا."
        }
      ]
    },
    {
      "title": "Akkusativ: الفعل بيقع على الشيء",
      "rule": "لما بتعمل فعل بالشيء (زي الرؤية)، المذكر بيتحول من der لـ den.",
      "forms": [
        "der → den",
        "sehen",
        "fragen"
      ],
      "examples": [
        {
          "de": "Wir sehen den Mann.",
          "ar": "بنشوف الرجل."
        },
        {
          "de": "Der Arzt fragt den Mann.",
          "ar": "الدكتور بيسأل الرجل."
        }
      ]
    },
    {
      "title": "Dativ: المستفيد",
      "rule": "لما بتعمل حاجة لمصلحة الشيء، المذكر بيتحول من der لـ dem.",
      "forms": [
        "der → dem",
        "helfen",
        "antworten"
      ],
      "examples": [
        {
          "de": "Wir helfen dem Mann.",
          "ar": "بنساعد الرجل."
        },
        {
          "de": "Wir antworten dem Arzt.",
          "ar": "بنجاوب الدكتور."
        }
      ]
    },
    {
      "title": "افهم بالعربي الأول",
      "rule": "مفيش حفظ: اسأل نفسك: بتوصف؟ بتعمل بالشيء؟ ولا بتفيده؟ ومن ده تختار der / den / dem.",
      "forms": [
        "وصف → der",
        "فعل واقع → den",
        "مستفيد → dem"
      ],
      "examples": [
        {
          "de": "Wir sehen den Lehrer.",
          "ar": "بنشوف المعلم."
        },
        {
          "de": "Wir helfen dem Lehrer.",
          "ar": "بنساعد المعلم."
        }
      ]
    }
  ],
