  "lesson": {
    "summary": "الجلسة دي بتخرجنا من دايرة 'أنا' وبتفتح هو (er) وهي (sie). الحلو إن الأفعال المودالية مع er/sie بتتصرف زي ich بالظبط: er muss زي ich muss. وكمان حركة صياعة الألمان: التعويض بـ es بدل ما نكرر اسم الحاجة، مع مكعبات التسوق والروتين: das Handy، das Ticket، das Auto، arbeiten gehen، einkaufen gehen."
  },
  "grammar": [
    {
      "title": "er/sie: نفس تصريف ich",
      "rule": "الأفعال المودالية مع هو (er) وهي (sie) بتتصرف زي أنا (ich) بالظبط، مفيش أي تغيير: ich muss يبقى er muss وsie muss.",
      "forms": [
        "ich muss / er muss / sie muss",
        "ich kann / er kann / sie kann"
      ],
      "examples": [
        {
          "de": "Er muss arbeiten gehen.",
          "ar": "هو لازم يروح الشغل."
        },
        {
          "de": "Sie muss einkaufen gehen.",
          "ar": "هي لازم تروح تتسوق."
        }
      ]
    },
    {
      "title": "التعويض بـ es",
      "rule": "بدل ما نكرر اسم الحاجة في الجملة التانية، بنعوض عنها بـ es: Das Auto ist teuer, aber ich muss es kaufen. دي حركة بتخليك تتكلم زي النيتف.",
      "forms": [
        "das Handy → es",
        "das Ticket → es",
        "das Auto → es"
      ],
      "examples": [
        {
          "de": "Das Handy ist sehr teuer, aber er muss es kaufen.",
          "ar": "الموبايل غالي جداً، بس هو لازم يشتريه."
        },
        {
          "de": "Das Ticket ist sehr teuer, aber sie muss es kaufen.",
          "ar": "التذكرة غالية جداً، بس هي لازم تشتريها."
        }
      ]
    },
    {
      "title": "gehen + فعل: الروتين اليومي",
      "rule": "gehen بتتلم على فعل في المصدر وتعمل مكعب واحد معناه يروح يعمل حاجة: arbeiten gehen (يروح الشغل)، einkaufen gehen (يروح يتسوق)، schlafen gehen (يروح ينام). ومع مودال بيروح الاتنين آخر الجملة.",
      "forms": [
        "arbeiten gehen",
        "einkaufen gehen",
        "schlafen gehen"
      ],
      "examples": [
        {
          "de": "Er muss arbeiten gehen.",
          "ar": "هو لازم يروح الشغل."
        },
        {
          "de": "Ich gehe schlafen.",
          "ar": "أنا داخل أنام."
        }
      ]
    },
    {
      "title": "für mich / für dich",
      "rule": "بعد für الضمير بيبقى mich (لي) أو dich (لك): Das ist einfach für mich, aber schwierig für dich.",
      "forms": [
        "für mich = بالنسبة لي",
        "für dich = بالنسبة لك"
      ],
      "examples": [
        {
          "de": "Das ist sehr einfach für mich.",
          "ar": "ده سهل جداً بالنسبة لي."
        },
        {
          "de": "Das ist sehr schwierig für dich.",
          "ar": "ده صعب جداً بالنسبة لك."
        }
      ]
    }
  ],
